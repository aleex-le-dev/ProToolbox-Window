<Page x:Class="ScriptsWindows.Views.Pages.ParametresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Paramètres">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--   1. CARTE PRINCIPALE : EXPORT CATÉGORIES & SOUS-CATÉGORIES    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <!-- En-tête de la carte -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCopyMarkdown"
                                    Content="📝 Copier en Markdown"
                                    Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Padding="12,8,12,8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Margin="0,0,10,0"
                                    ToolTip="Copier la liste au format Markdown avec puces"
                                    Click="BtnCopyMarkdown_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="BtnCopyHierarchy"
                                    Content="📋 Copier la liste (1 clic)"
                                    Background="{DynamicResource Accent}"
                                    BorderThickness="0"
                                    Foreground="#FFFFFF"
                                    Padding="16,8,16,8"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Copier toutes les catégories et sous-catégories dans le presse-papiers"
                                    Click="BtnCopyHierarchy_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📁 Structure des catégories &amp; sous-catégories"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Arborescence intégrale de tous les modules classés par ordre alphabétique. Copiez la liste instantanément."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Message temporaire de confirmation de copie -->
                    <Border x:Name="CopyFeedbackBorder"
                            Visibility="Collapsed"
                            Background="#10B98122"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8,12,8"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="TxtCopyFeedback"
                                   Text="✅ Liste copiée dans le presse-papiers !"
                                   Foreground="#34D399"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </Border>

                    <!-- Zone de prévisualisation arborescente -->
                    <Border Background="{DynamicResource TerminalBg}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                        <TextBox x:Name="TxtHierarchyPreview"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--           2. ESPACE RÉSERVÉ AUX FUTURS PARAMÈTRES              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚙️ Préférences &amp; Options générales"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Cet espace est configuré pour accueillir vos futurs réglages personnalisés."
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,4,0,16" />

                    <!-- Option fictive / template 1 -->
                    <Border Background="{DynamicResource BgDeep}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12,14,12"
                            Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3,8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Bientôt disponible" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Comportement de la console" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Affichage automatique du volet de console lors du lancement d'un script" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Option fictive / template 2 -->
                    <Border Background="{DynamicResource BgDeep}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12,14,12">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3,8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Bientôt disponible" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Mode de confirmation avant exécution" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Demander une confirmation pour les scripts critiques système ou réseau" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                       3. INFORMATIONS SYSTÈME                  -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18,22,18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Alex Toolkit v4.0" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                        <TextBlock Text="Développé par AleexLeDev" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ℹ️ À propos" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Environnement .NET 8.0 WPF natif x64 pour Windows 10 &amp; Windows 11" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
