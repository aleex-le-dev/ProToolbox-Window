<Page x:Class="ScriptsWindows.Views.Pages.ParametresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Paramètres">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                   1. APPARENCE ET THÈME                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18,22,18"
                    Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnToggleTheme"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Click="BtnToggleTheme_Click"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            Padding="14,8,16,8"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="15" FontFamily="{StaticResource FontEmoji}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtThemeName" Text="Noir pur oled" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎨 Apparence et thème"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Basculez entre le thème sombre noir pur oled et le thème clair épuré."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--   2. STRUCTURE DÉTAILLÉE : SCRIPTS, EXÉCUTABLES ET COMMANDES    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <!-- En-tête de la carte -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                            <Button x:Name="BtnCopyHierarchy"
                                    Content="📋 Copier l'arborescence"
                                    Background="{DynamicResource Accent}"
                                    BorderThickness="0"
                                    Foreground="#FFFFFF"
                                    Padding="16,8,16,8"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Copier toute l'arborescence détaillée"
                                    Click="BtnCopyHierarchy_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📁 Arborescence des scripts et commandes de ce projet"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Inventaire complet de chaque catégorie, script et commande / binaire .exe sous-jacent."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Message temporaire de confirmation de copie -->
                    <Border x:Name="CopyFeedbackBorder"
                            Visibility="Collapsed"
                            Background="#10B98122"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8,12,8"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="TxtCopyFeedback"
                                   Text="✅ Liste copiée dans le presse-papiers !"
                                   Foreground="#34D399"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </Border>

                    <!-- Zone de prévisualisation arborescente -->
                    <Border Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                        <TextBox x:Name="TxtHierarchyPreview"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="360"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--     3. À PROPOS ET CONFIGURATION COMPLÈTE DE CET ORDINATEUR     -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--     3. À PROPOS ET FICHE DE SPÉCIFICATIONS TECHNIQUES           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCopySpecs"
                                    Content="Copier la fiche"
                                    Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Padding="14,7,14,7"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    ToolTip="Copier la fiche de spécifications complète"
                                    Click="BtnCopySpecs_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Spécifications du PC"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Fiche technique de votre ordinateur : matériel, système d'exploitation et stockage."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Message temporaire de confirmation de copie de la fiche -->
                    <Border x:Name="CopySpecsFeedbackBorder"
                            Visibility="Collapsed"
                            Background="#10B98122"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8,12,8"
                            Margin="0,0,0,14">
                        <TextBlock Text="Fiche de spécifications copiée dans le presse-papiers !"
                                   Foreground="#34D399"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </Border>

                    <!-- Fiche de spécification en 1 seul bloc, ligne par ligne (sans icônes) -->
                    <Border Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <!-- Ligne 1 : Ordinateur et utilisateur -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ordinateur &amp; Utilisateur" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpecMachine" Grid.Column="1" Text="Chargement..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Ligne 2 : Privilèges d'exécution -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Droits d'accès" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpecPrivileges" Grid.Column="1" Text="Chargement..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Ligne 3 : Système d'exploitation -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Système d'exploitation" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpecOS" Grid.Column="1" Text="Chargement..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Ligne 4 : Processeur (CPU) -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Processeur (CPU)" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpecCPU" Grid.Column="1" Text="Chargement..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Ligne 5 : Mémoire vive (RAM) -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mémoire vive (RAM)" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpecRAM" Grid.Column="1" Text="Chargement..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Ligne 6 : Disques & Stockage -->
                            <Border BorderThickness="0" Padding="18,12,18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Disques &amp; Stockage" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <!-- Liste des disques : chaque disque sur sa propre ligne -->
                                    <StackPanel x:Name="PanelDisksSpecs" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Chargement des disques..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--   4. PIED DE PAGE : ANCRÉ AU BAS DE L'APPLICATION AU CENTRE     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1"
            Background="{DynamicResource BgDeep}"
            Padding="0,12,0,16">
        <TextBlock x:Name="TxtAppBuildInfo"
                   Text="Dernière mise à jour : ..."
                   FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
    </Border>

</Grid>
</Page>
