<Page x:Class="ScriptsWindows.Views.Pages.ParametresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Paramètres">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                   1. APPARENCE ET THÈME                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18,22,18"
                    Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnToggleTheme"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Click="BtnToggleTheme_Click"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            Padding="14,8,16,8"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="15" FontFamily="{StaticResource FontEmoji}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtThemeName" Text="Noir pur oled" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎨 Apparence et thème"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Basculez entre le thème sombre noir pur oled et le thème clair épuré."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--   2. STRUCTURE DÉTAILLÉE : SCRIPTS, EXÉCUTABLES ET COMMANDES    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <!-- En-tête de la carte -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                            <Button x:Name="BtnCopyHierarchy"
                                    Content="📋 Copier l'arborescence"
                                    Background="{DynamicResource Accent}"
                                    BorderThickness="0"
                                    Foreground="#FFFFFF"
                                    Padding="16,8,16,8"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Copier toute l'arborescence détaillée"
                                    Click="BtnCopyHierarchy_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📁 Arborescence des scripts et commandes de ce projet"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Inventaire complet de chaque catégorie, script et commande / binaire .exe sous-jacent."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Message temporaire de confirmation de copie -->
                    <Border x:Name="CopyFeedbackBorder"
                            Visibility="Collapsed"
                            Background="#10B98122"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8,12,8"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="TxtCopyFeedback"
                                   Text="✅ Liste copiée dans le presse-papiers !"
                                   Foreground="#34D399"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </Border>

                    <!-- Zone de prévisualisation arborescente -->
                    <Border Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                        <TextBox x:Name="TxtHierarchyPreview"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="360"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--     3. À PROPOS ET CONFIGURATION COMPLÈTE DE CET ORDINATEUR     -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20,22,20">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ℹ️ À propos et configuration de cet ordinateur"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Informations matérielles, système et environnement d'exécution de la machine active."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Grille des spécifications du PC (5 cartes) -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nom Machine et Session -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="{DynamicResource BgDeep}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,12"
                                Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock Text="💻 Ordinateur et utilisateur" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtSpecMachine" Text="Chargement..." FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Système d'exploitation -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{DynamicResource BgDeep}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,12"
                                Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🪟 Système d'exploitation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtSpecOS" Text="Chargement..." FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Processeur (CPU) -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{DynamicResource BgDeep}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,12"
                                Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock Text="🧠 Processeur (CPU)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtSpecCPU" Text="Chargement..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Mémoire vive (RAM) -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource BgDeep}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,12"
                                Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚡ Mémoire vive (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtSpecRAM" Text="Chargement..." FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Stockage système (C:) -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{DynamicResource BgDeep}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,12"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="💽 Disque système (C:)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtSpecDisk" Text="Chargement..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--   4. PIED DE PAGE : ANCRÉ AU BAS DE L'APPLICATION AU CENTRE     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1"
            Background="{DynamicResource BgDeep}"
            Padding="0,12,0,16">
        <TextBlock x:Name="TxtAppBuildInfo"
                   Text="Dernière mise à jour : ..."
                   FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
    </Border>

</Grid>
</Page>
