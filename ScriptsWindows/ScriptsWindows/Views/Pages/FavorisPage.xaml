<Page x:Class="ScriptsWindows.Views.Pages.FavorisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Mes Favoris">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <!-- En-tête des favoris avec compteur dynamique -->
            <Border x:Name="HeaderPanel"
                    Margin="0,0,0,16"
                    Padding="16,12,16,12"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE735;"
                                   Foreground="#FBBF24"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtFavCount"
                                   Text="Vos raccourcis rapides"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Cliquez sur l'étoile d'un script pour l'épingler"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Info si pas de favoris -->
            <Border x:Name="EmptyState"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource AccentDim}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Text="&#xE735;"
                                   Foreground="#FBBF24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Aucun favori enregistré"
                               FontFamily="{StaticResource FontMain}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Vous n'avez pas encore d'outils favoris. Cliquez sur l'étoile en haut à droite de n'importe quelle carte pour l'ajouter ici et y accéder instantanément."
                               FontFamily="{StaticResource FontMain}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Grille des cartes favoris -->
            <ItemsControl x:Name="FavorisGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
