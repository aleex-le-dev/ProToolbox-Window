<Page x:Class="ScriptsWindows.Views.Pages.FavorisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Mes Favoris">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <!-- Info si pas de favoris -->
            <Border x:Name="EmptyState"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource AccentDim}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Text="&#xE735;"
                                   Foreground="#FBBF24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Aucun favori enregistré"
                               FontFamily="{StaticResource FontMain}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Vous n'avez pas encore d'outils favoris. Cliquez sur l'étoile en haut à droite de n'importe quelle carte pour l'ajouter ici et y accéder instantanément."
                               FontFamily="{StaticResource FontMain}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Organisation par sous-titres de composants -->
            <StackPanel x:Name="ToolsPanel" />
        </StackPanel>
    </ScrollViewer>
</Page>
