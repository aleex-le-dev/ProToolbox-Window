<Page x:Class="ScriptsWindows.Views.Pages.FavorisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgDeep}"
      Title="Mes favoris">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">

            <!-- Info si pas de favoris -->
            <Border x:Name="EmptyState"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource AccentDim}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock FontFamily="{StaticResource FontIcon}"
                                   FontSize="26"
                                   Text="&#xE735;"
                                   Foreground="{DynamicResource WarningText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Aucun favori pour le moment"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cliquez sur l'étoile d'une carte d'outil pour l'épingler ici et la retrouver en un clic."
                               FontFamily="{StaticResource FontMain}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Organisation par sous-titres de composants -->
            <StackPanel x:Name="ToolsPanel" />
        </StackPanel>
    </ScrollViewer>
</Page>
