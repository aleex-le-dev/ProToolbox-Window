<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.CrashDriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pannes &amp; pilotes"
        Width="920" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="760" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Style="{StaticResource ActionButton}" VerticalAlignment="Center" Click="BtnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource DangerBg}" Margin="0,0,14,0">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource DangerText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pannes &amp; pilotes" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Écrans bleus des 90 derniers jours et périphériques en erreur, avec la cause probable et la marche à suivre."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Indicateurs -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ÉCRANS BLEUS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="TxtCrashCount" Text="…" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ARRÊTS BRUTAUX (COUPURES, GELS)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="TxtShutdownCount" Text="…" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="PÉRIPHÉRIQUES EN ERREUR" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="TxtDeviceCount" Text="…" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Écrans bleus -->
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Ouvrir le dossier Minidump" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,4" MinHeight="28" Click="BtnOpenMinidump_Click"/>
                    <TextBlock Text="Écrans bleus" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TxtNoCrash" Text="Aucun écran bleu enregistré ces 90 derniers jours." Foreground="{DynamicResource SuccessText}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                <ItemsControl x:Name="ListCrashes" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource DangerText}" FontFamily="{StaticResource FontMono}"/>
                                        <TextBlock Text="{Binding Cause}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding DumpPath}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Périphériques -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Rechercher les modifications matérielles" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,4" MinHeight="28" Margin="0,0,8,0" Click="BtnScanHardware_Click"/>
                        <Button Content="Gestionnaire de périphériques" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,4" MinHeight="28" Click="BtnDevMgmt_Click"/>
                    </StackPanel>
                    <TextBlock Text="Périphériques en erreur" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TxtNoDevice" Text="Tous les périphériques fonctionnent normalement." Foreground="{DynamicResource SuccessText}" FontSize="12" Visibility="Collapsed"/>
                <ItemsControl x:Name="ListDevices">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource WarningText}" FontSize="11.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Réinstaller" Style="{StaticResource ActionButton}" FontSize="12" Padding="12,4" MinHeight="28"
                                            VerticalAlignment="Center" Tag="{Binding}" Click="BtnReinstall_Click"
                                            ToolTip="Supprime le périphérique puis relance la détection : Windows réinstalle son pilote."/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <ProgressBar x:Name="ProgBar" DockPanel.Dock="Right" Width="120" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0"/>
            <TextBlock x:Name="TxtStatus" Text="Analyse en cours…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
