<Window x:Class="ScriptsWindows.Views.Controls.DnsManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire et Changeur de DNS"
        Width="620" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestionnaire et Changeur de DNS" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Changez instantanément vos serveurs DNS pour booster votre débit, confidentialité et sécurité."
                       Foreground="#9CA3AF" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Informations Réseau Actuel -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Carte réseau sélectionnée :" FontWeight="SemiBold" Foreground="#D1D5DB"/>
                    <Button Grid.Column="1" Content="🔄 Rafraîchir" Style="{StaticResource ActionButton}" Padding="8,4" Click="BtnRefresh_Click"/>
                </Grid>
                <ComboBox x:Name="CmbAdapters" Height="36" Background="#111827" Foreground="#F9FAFB"
                          BorderBrush="#4B5563" SelectionChanged="CmbAdapters_SelectionChanged" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DNS Actuels :" Foreground="#9CA3AF" FontSize="11"/>
                        <TextBlock x:Name="TxtCurrentDns" Text="Détection en cours..." FontWeight="Bold" Foreground="#60A5FA" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Adresse IPv4 :" Foreground="#9CA3AF" FontSize="11"/>
                        <TextBlock x:Name="TxtCurrentIp" Text="—" Foreground="#F9FAFB" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Préréglages DNS en 1 clic -->
        <Border Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PRÉRÉGLAGES DNS (APPLICATION EN 1 CLIC)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="☁️ Cloudflare (1.1.1.1)" Margin="0,0,6,0"
                            Style="{StaticResource PrimaryActionButton}" Click="BtnSetCloudflare_Click"/>
                    <Button Grid.Column="1" Content="🔍 Google DNS (8.8.8.8)" Margin="6,0,0,0"
                            Style="{StaticResource ActionButton}" Click="BtnSetGoogle_Click"/>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🛡️ Quad9 Sécurisé (9.9.9.9)" Margin="0,0,6,0"
                            Style="{StaticResource ActionButton}" Click="BtnSetQuad9_Click"/>
                    <Button Grid.Column="1" Content="🔄 Automatique (DHCP Box)" Margin="6,0,0,0"
                            Style="{StaticResource ActionButton}" Click="BtnSetDhcp_Click"/>
                </Grid>

                <!-- Utilitaire de vidage de cache -->
                <Button Content="🧹 Vider le cache DNS local (ipconfig /flushdns)"
                        Style="{StaticResource ActionButton}" Click="BtnFlushDns_Click"/>
            </StackPanel>
        </Border>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <TextBlock x:Name="TxtFeedback" Text="" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
