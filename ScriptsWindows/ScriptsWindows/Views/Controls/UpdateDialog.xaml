<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour d'Alex Toolkit"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Styles de boutons harmonisés -->


        <!-- Convertisseur bool vers visibilité -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style de ProgressBar moderne néon -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Sélecteur d'onglets -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--                 EN-TÊTE                    -->
        <!-- ══════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
            <Button x:Name="BtnRefresh"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionButton}"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Click="BtnRefresh_Click"
                    ToolTip="Vérifier à nouveau en ligne">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Mise à jour d'Alex Toolkit"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Système officiel de mise à jour intégrée et historique des versions d'Alex Toolkit."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ══════════════════════════════════════════ -->
        <!--            ONGLETS DE NAVIGATION           -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabBtnDirectUpdate"
                        Grid.Column="0"
                        Content="🚀 Mise à jour automatique"
                        Background="{DynamicResource BgInput}"
                        Foreground="{DynamicResource TextPrimary}"
                        FontWeight="Bold"
                        FontSize="12.5"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TabBtnDirectUpdate_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="TabBtnMirror"
                        Grid.Column="1"
                        Content="📁 Historique des versions"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}"
                        FontWeight="SemiBold"
                        FontSize="12.5"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TabBtnMirror_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--           CONTENU DES ONGLETS              -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">

            <!-- ── VUE 1 : MISE À JOUR DIRECTE ──────────────── -->
            <Grid x:Name="ViewDirectUpdate" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Bannière d'état -->
                    <RowDefinition Height="Auto"/>
                    <!-- Comparaison des versions -->
                    <RowDefinition Height="Auto"/>
                    <!-- Changelog / Notes de version -->
                    <RowDefinition Height="*"/>
                    <!-- Barre de progression -->
                    <RowDefinition Height="Auto"/>
                    <!-- Boutons d'action -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bannière d'état dynamique -->
                <Border x:Name="BannerStatus"
                        Grid.Row="0"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtBannerIcon"
                                   DockPanel.Dock="Left"
                                   Text="🔄"
                                   FontSize="22"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBannerTitle"
                                       Text="Vérification en cours..."
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtBannerSubtitle"
                                       Text="Connexion aux serveurs officiels d'Alex Toolkit..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Comparatif de versions (Cartes côte à côte) -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Version installée -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="VERSION ACTUELLE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="TxtCurrentVersion"
                                       Text="v4.1.0"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentText}"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtCurrentDetails"
                                       Text="Installé localement"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dernière version en ligne -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="DERNIÈRE VERSION DISPONIBLE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="TxtRemoteVersion"
                                       Text="..."
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessText}"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtRemoteDetails"
                                       Text="Recherche..."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notes de version / Changelog -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BgDeep}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="📝 Notes de publication &amp; Nouveautés"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtChangelog"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="12"
                                 FontFamily="{StaticResource FontMain}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Chargement du journal des modifications..."/>
                    </DockPanel>
                </Border>

                <!-- Zone de progression de téléchargement (masquée par défaut) -->
                <Border x:Name="DownloadProgressPanel"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtDownloadProgressPct"
                                       DockPanel.Dock="Right"
                                       Text="0%"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentText}"/>
                            <TextBlock x:Name="TxtDownloadProgressStatus"
                                       Text="Téléchargement du nouvel exécutable en cours..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgDownload"
                                     Style="{StaticResource ModernProgressBar}"
                                     Value="0"
                                     Maximum="100"/>
                        <TextBlock x:Name="TxtDownloadSpeed"
                                   Text="0 Mo / 0 Mo"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Barre de boutons d'action -->
                <DockPanel Grid.Row="4" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnApplyUpdate"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="BtnApplyUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mettre à jour et redémarrer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDownloadAs"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="BtnDownloadAs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Enregistrer sous..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="BtnOpenGitHub"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ActionButton}"
                            Click="BtnOpenGitHub_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voir sur GitHub" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

            </Grid>

            <!-- ── VUE 2 : HISTORIQUE DES VERSIONS ────────── -->
            <Grid x:Name="ViewMirror" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 Miroir des distributions d'Alex Toolkit"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Parcourez l'historique complet des versions publiées. Vous pouvez télécharger directement n'importe quel binaire autonome."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource BgDeep}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <ListBox x:Name="ListReleases"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <DockPanel LastChildFill="True">
                                        <!-- Actions à droite -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionButton}"
                                                    Content="💾 Télécharger"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="BtnDownloadMirrorItem_Click"/>
                                            <Button Style="{StaticResource ActionButton}"
                                                    Content="🌐 Release"
                                                    Padding="10,6"
                                                    Tag="{Binding HtmlUrl}"
                                                    Click="BtnOpenMirrorUrl_Click"/>
                                        </StackPanel>

                                        <!-- Détails release -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TagName}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource AccentText}"
                                                           Margin="0,0,10,0"/>
                                                <!-- Badge version actuelle -->
                                                <Border Background="{DynamicResource SuccessBg}"
                                                        BorderBrush="{DynamicResource Success}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="Actuelle" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                                                </Border>
                                                <!-- Badge mise à jour -->
                                                <Border Background="{DynamicResource AccentDim}"
                                                        BorderBrush="{DynamicResource Accent}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="Nouveau" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="Publié le : " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding PublishedAtFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0"/>
                                                <TextBlock Text="Taille : " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--                 PIED DE PAGE               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ActionButton}"
                        Content="Fermer"
                        Padding="20,7"
                        Click="BtnClose_Click"/>

                <CheckBox x:Name="ChkAutoCheck"
                          Content="Rechercher automatiquement les mises à jour au démarrage"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondary}"
                          VerticalAlignment="Center"
                          Checked="ChkAutoCheck_Changed"
                          Unchecked="ChkAutoCheck_Changed"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
