<Window x:Class="ScriptsWindows.Views.Controls.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour d'Alex Toolkit"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Styles de boutons harmonisés -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#818CF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Convertisseur bool vers visibilité -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style de ProgressBar moderne néon -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Sélecteur d'onglets -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--                 EN-TÊTE                    -->
        <!-- ══════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
            <Button x:Name="BtnRefresh"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionButton}"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Click="BtnRefresh_Click"
                    ToolTip="Vérifier à nouveau en ligne">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Mise à jour d'Alex Toolkit"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Système officiel de mise à jour intégrée et historique des versions d'Alex Toolkit."
                           FontSize="12"
                           Foreground="#9CA3AF"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ══════════════════════════════════════════ -->
        <!--            ONGLETS DE NAVIGATION           -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#1F2937"
                BorderBrush="#374151"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabBtnDirectUpdate"
                        Grid.Column="0"
                        Content="🚀 Mise à jour automatique"
                        Background="#374151"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="12.5"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TabBtnDirectUpdate_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="TabBtnMirror"
                        Grid.Column="1"
                        Content="📁 Historique des versions"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        FontWeight="SemiBold"
                        FontSize="12.5"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TabBtnMirror_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--           CONTENU DES ONGLETS              -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">

            <!-- ── VUE 1 : MISE À JOUR DIRECTE ──────────────── -->
            <Grid x:Name="ViewDirectUpdate" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Bannière d'état -->
                    <RowDefinition Height="Auto"/>
                    <!-- Comparaison des versions -->
                    <RowDefinition Height="Auto"/>
                    <!-- Changelog / Notes de version -->
                    <RowDefinition Height="*"/>
                    <!-- Barre de progression -->
                    <RowDefinition Height="Auto"/>
                    <!-- Boutons d'action -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bannière d'état dynamique -->
                <Border x:Name="BannerStatus"
                        Grid.Row="0"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtBannerIcon"
                                   DockPanel.Dock="Left"
                                   Text="🔄"
                                   FontSize="22"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBannerTitle"
                                       Text="Vérification en cours..."
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtBannerSubtitle"
                                       Text="Connexion aux serveurs officiels d'Alex Toolkit..."
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Comparatif de versions (Cartes côte à côte) -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Version installée -->
                    <Border Grid.Column="0"
                            Background="#1F2937"
                            BorderBrush="#374151"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="VERSION ACTUELLE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtCurrentVersion"
                                       Text="v4.1.0"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#60A5FA"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtCurrentDetails"
                                       Text="Installé localement"
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dernière version en ligne -->
                    <Border Grid.Column="2"
                            Background="#1F2937"
                            BorderBrush="#374151"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="DERNIÈRE VERSION DISPONIBLE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtRemoteVersion"
                                       Text="..."
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#34D399"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtRemoteDetails"
                                       Text="Recherche..."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notes de version / Changelog -->
                <Border Grid.Row="2"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="📝 Notes de publication &amp; Nouveautés"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtChangelog"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E2E8F0"
                                 FontSize="12"
                                 FontFamily="{StaticResource FontMain}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Chargement du journal des modifications..."/>
                    </DockPanel>
                </Border>

                <!-- Zone de progression de téléchargement (masquée par défaut) -->
                <Border x:Name="DownloadProgressPanel"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        Background="#1E293B"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtDownloadProgressPct"
                                       DockPanel.Dock="Right"
                                       Text="0%"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#818CF8"/>
                            <TextBlock x:Name="TxtDownloadProgressStatus"
                                       Text="Téléchargement du nouvel exécutable en cours..."
                                       FontSize="11.5"
                                       Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgDownload"
                                     Style="{StaticResource ModernProgressBar}"
                                     Value="0"
                                     Maximum="100"/>
                        <TextBlock x:Name="TxtDownloadSpeed"
                                   Text="0 Mo / 0 Mo"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Barre de boutons d'action -->
                <DockPanel Grid.Row="4" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnApplyUpdate"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="BtnApplyUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mettre à jour et redémarrer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDownloadAs"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="BtnDownloadAs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Enregistrer sous..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="BtnOpenGitHub"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ActionButton}"
                            Click="BtnOpenGitHub_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voir sur GitHub" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

            </Grid>

            <!-- ── VUE 2 : HISTORIQUE DES VERSIONS ────────── -->
            <Grid x:Name="ViewMirror" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#1F2937"
                        BorderBrush="#374151"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 Miroir des distributions d'Alex Toolkit"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Parcourez l'historique complet des versions publiées. Vous pouvez télécharger directement n'importe quel binaire autonome."
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <ListBox x:Name="ListReleases"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <DockPanel LastChildFill="True">
                                        <!-- Actions à droite -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionButton}"
                                                    Content="💾 Télécharger"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="BtnDownloadMirrorItem_Click"/>
                                            <Button Style="{StaticResource ActionButton}"
                                                    Content="🌐 Release"
                                                    Padding="10,6"
                                                    Tag="{Binding HtmlUrl}"
                                                    Click="BtnOpenMirrorUrl_Click"/>
                                        </StackPanel>

                                        <!-- Détails release -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TagName}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="#60A5FA"
                                                           Margin="0,0,10,0"/>
                                                <!-- Badge version actuelle -->
                                                <Border Background="#10B98122"
                                                        BorderBrush="#10B981"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="Actuelle" FontSize="10.5" FontWeight="Bold" Foreground="#34D399"/>
                                                </Border>
                                                <!-- Badge mise à jour -->
                                                <Border Background="#6366F122"
                                                        BorderBrush="#6366F1"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="Nouveau" FontSize="10.5" FontWeight="Bold" Foreground="#A5B4FC"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E2E8F0"
                                                       Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="Publié le : " FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding PublishedAtFormatted}" FontSize="11" Foreground="#94A3B8" Margin="0,0,14,0"/>
                                                <TextBlock Text="Taille : " FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--                 PIED DE PAGE               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ActionButton}"
                        Content="Fermer"
                        Padding="20,7"
                        Click="BtnClose_Click"/>

                <CheckBox x:Name="ChkAutoCheck"
                          Content="Rechercher automatiquement les mises à jour au démarrage"
                          FontSize="12"
                          Foreground="#9CA3AF"
                          VerticalAlignment="Center"
                          Checked="ChkAutoCheck_Changed"
                          Unchecked="ChkAutoCheck_Changed"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
