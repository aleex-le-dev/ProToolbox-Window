<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.TcpConnectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moniteur des Connexions TCP Actives"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Moniteur des Connexions TCP Actives" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Visualisation en direct des flux réseau, ports locaux/distants et logiciels émetteurs."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de filtres et recherche -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtSearch" Height="34" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderStrong}" Padding="8,6" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="Rechercher (processus, IP, port)..." Foreground="{DynamicResource TextMuted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Indicateur -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TxtStatus" Text="Chargement des connexions..." Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                </StackPanel>

                <!-- Bouton Refresh -->
                <Button Grid.Column="2" x:Name="BtnRefresh" Content="🔄 Actualiser" Margin="0,0,10,0"
                        Style="{StaticResource ActionButton}" Click="BtnRefresh_Click"/>

                <!-- Badge Compteur -->
                <Border Grid.Column="3" Background="{DynamicResource BgDeep}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountBadge" Text="0 connexion(s)" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tableau des connexions TCP -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-têtes de colonnes -->
                <Border Grid.Row="0" Background="{DynamicResource BgDeep}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCESSUS (PID)" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="ADRESSE LOCALE" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="ADRESSE DISTANTE" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="ÉTAT" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Liste avec scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsTcpList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="2,2,2,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Processus & PID -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                            <TextBlock Text="{Binding PidText}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                        </StackPanel>

                                        <!-- Adresse locale -->
                                        <TextBlock Grid.Column="1" Text="{Binding LocalAddress}" Foreground="{DynamicResource AccentText}" FontSize="11" VerticalAlignment="Center"/>

                                        <!-- Adresse distante -->
                                        <TextBlock Grid.Column="2" Text="{Binding RemoteAddress}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center"/>

                                        <!-- Badge État -->
                                        <Border Grid.Column="3" Background="{Binding StateColor}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
