<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.DnsBenchmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benchmark &amp; Test de Vitesse DNS en Temps Réel"
        Width="860" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>


        <Style x:Key="ApplyDnsButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Success}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCard}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Benchmark &amp; Testeur de Vitesse DNS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Mesurez le temps de ping et la latence réelle de résolution pour trouver le résolveur le plus rapide."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Bandeau DNS ACTIF EN DIRECT -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Success}" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="● DNS ACTIF SUR VOTRE PC :" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center"/>
                        <Border x:Name="ActiveDnsBadgeBorder" Background="{DynamicResource SuccessBg}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtActiveDnsBadge" Text="EN SERVICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtActiveDnsName" Text="Détection du DNS actif..." FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,1"/>
                    <TextBlock x:Name="TxtActiveDnsDetails" Text="Adresses IP configurées : ..." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRunBenchmark" Content="🚀 Lancer le test" Style="{StaticResource PrimaryActionButton}" Padding="16,8" VerticalAlignment="Center" Click="BtnRunBenchmark_Click"/>
            </Grid>
        </Border>

        <!-- Liste des résultats avec marge anti-ascenseur -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ItemsControl x:Name="DnsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nom & Serveur -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            <Border Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" Visibility="{Binding ActiveBadgeVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="● ACTIF SUR CE PC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding WinnerBadgeText}" Foreground="{DynamicResource WarningText}" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" Visibility="{Binding WinnerBadgeVisibility}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Ping ICMP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ping" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding PingText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentText}"/>
                                    </StackPanel>

                                    <!-- Résolution -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Résolution" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding ResolveText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentText}"/>
                                    </StackPanel>

                                    <!-- Bouton Appliquer -->
                                    <Button Grid.Column="3" Content="{Binding ActionButtonText}" Style="{StaticResource ApplyDnsButton}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnApplyDns_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Barre inférieure avec Revenir en arrière (DHCP) -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="BtnRestoreDhcp" Content="🔄 Revenir en arrière (DHCP automatique Box)" Style="{StaticResource ActionButton}" Padding="12,6" FontSize="12" HorizontalAlignment="Left" Click="BtnRestoreDhcp_Click"/>
            <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
