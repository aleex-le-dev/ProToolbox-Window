<Window x:Class="ScriptsWindows.Views.Controls.PrivacyShieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bouclier de Confidentialité &amp; Anti-Télémétrie"
        Width="740" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Bouclier de Confidentialité" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Protégez vos données personnelles en coupant la télémétrie Windows, le ciblage publicitaire et le suivi de saisie."
                       Foreground="#9CA3AF" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Tableau des statuts en direct -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="État de protection de votre système :" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 Actualiser" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnRefresh_Click"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Télémétrie diagnostique (Service DiagTrack)" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock x:Name="TxtDiagTrackStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Identifiant publicitaire Windows (Advertising ID)" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock x:Name="TxtAdStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Suivi des frappes clavier &amp; écriture manuscrite" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock x:Name="TxtTypingStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Publicités et suggestions dans le menu Démarrer" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock x:Name="TxtStartAdsStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions principales : Activer ou Revenir en arrière -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Option 1 : Activer le bouclier -->
            <Border x:Name="CardEnableShield" Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activer la protection maximale" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Coupe les services de collecte, bloque les trackers publicitaires et empêche Windows d'enregistrer vos frappes."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnEnableShield" Content="Activer le Bouclier" Style="{StaticResource PrimaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnEnableShield_Click"/>
                </Grid>
            </Border>

            <!-- Option 2 : Revenir en arrière (Restaurer défaut Windows) -->
            <Border x:Name="CardRestoreDefaults" Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Revenir en arrière (Défaut Windows)" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Restaure la configuration d'origine de Windows (réactive le service de diagnostic et les réglages standards)."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRestoreDefaults" Content="Revenir en arrière" Style="{StaticResource SecondaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRestoreDefaults_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre inférieure -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Sélectionnez une action ci-dessus." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
