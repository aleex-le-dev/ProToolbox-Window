<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.PrivacyShieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bouclier de Confidentialité &amp; Anti-Télémétrie"
        Width="740" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>


    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Bouclier de Confidentialité" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Protégez vos données personnelles en coupant la télémétrie Windows, le ciblage publicitaire et le suivi de saisie."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Tableau des statuts en direct -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="État de protection de votre système :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 Actualiser" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnRefresh_Click"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Télémétrie diagnostique (Service DiagTrack)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtDiagTrackStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Identifiant publicitaire Windows (Advertising ID)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtAdStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Suivi des frappes clavier &amp; écriture manuscrite" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtTypingStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Publicités et suggestions dans le menu Démarrer" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtStartAdsStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions principales : Activer ou Revenir en arrière -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Option 1 : Activer le bouclier -->
            <Border x:Name="CardEnableShield" Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activer la protection maximale" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Coupe les services de collecte, bloque les trackers publicitaires et empêche Windows d'enregistrer vos frappes."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnEnableShield" Content="Activer le Bouclier" Style="{StaticResource PrimaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnEnableShield_Click"/>
                </Grid>
            </Border>

            <!-- Option 2 : Revenir en arrière (Restaurer défaut Windows) -->
            <Border x:Name="CardRestoreDefaults" Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Revenir en arrière (Défaut Windows)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Restaure la configuration d'origine de Windows (réactive le service de diagnostic et les réglages standards)."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRestoreDefaults" Content="Revenir en arrière" Style="{StaticResource SecondaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRestoreDefaults_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre inférieure -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Sélectionnez une action ci-dessus." Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
