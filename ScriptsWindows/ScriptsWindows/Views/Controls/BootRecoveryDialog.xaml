<Window x:Class="ScriptsWindows.Views.Controls.BootRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Démarrage &amp; Récupération Windows"
        Width="780" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#B45309"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Démarrage &amp; Récupération Windows" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Contrôlez les options de démarrage avancé, accédez à la réparation WinRE, au BIOS/UEFI et restaurez le magasin BCD."
                       Foreground="#9CA3AF" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- 2. Bannière de statut système -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Statut de démarrage BCD : " Foreground="#9CA3AF" FontSize="13"/>
                    <TextBlock x:Name="TxtSafeModeStatus" Text="Analyse en cours..." FontWeight="Bold" Foreground="#60A5FA" FontSize="13" Margin="0,0,24,0"/>

                    <TextBlock Text="Type de micrologiciel : " Foreground="#9CA3AF" FontSize="13"/>
                    <TextBlock x:Name="TxtFirmwareStatus" Text="Détection..." FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Actualiser l'état" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11" Click="BtnRefreshStatus_Click"/>
            </Grid>
        </Border>

        <!-- 3. Cartes d'actions principales -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- CARTE 1 : Mode sans échec -->
                <Border Background="#1A2234" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mode sans échec (Minimal / Réseau)" FontWeight="SemiBold" FontSize="15" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Démarre Windows avec un ensemble minimal de pilotes et services essentiels pour isoler et supprimer les virus ou les pannes de pilotes."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <Button Content="Mode Minimal" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnSafeModeMinimal_Click"/>
                            <Button Content="Mode Réseau (avec Internet)" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnSafeModeNetwork_Click"/>
                            <Button Content="Désactiver (Retour Normal)" Style="{StaticResource SuccessActionButton}" Margin="0,0,12,0" Click="BtnDisableSafeMode_Click"/>

                            <CheckBox x:Name="ChkRebootSafeMode" Content="Redémarrer immédiatement" IsChecked="True"
                                      Foreground="#D1D5DB" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- CARTE 2 : Environnement WinRE -->
                <Border Background="#1A2234" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🚑" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Environnement de récupération Windows (WinRE)" FontWeight="SemiBold" FontSize="15" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Redémarre l'ordinateur directement sur l'écran bleu des options de récupération (restauration système, invite de commandes, désinstallation des mises à jour problématiques)."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Accéder à WinRE immédiatement" Style="{StaticResource WarningActionButton}" Click="BtnRebootWinRE_Click"/>
                            <TextBlock Text="⚠️ Fermez vos documents ouverts avant de lancer le redémarrage." Foreground="#FBBF24" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTE 3 : Redémarrage BIOS / UEFI -->
                <Border Background="#1A2234" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="💻" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Redémarrage vers le BIOS / UEFI" FontWeight="SemiBold" FontSize="15" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Redémarre le PC et ouvre automatiquement l'interface de réglage UEFI de votre carte mère, sans devoir appuyer sur les touches F2 ou Suppr."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Redémarrer vers le BIOS / UEFI" Style="{StaticResource DangerActionButton}" Click="BtnRebootBios_Click"/>
                            <TextBlock Text="Requiert une carte mère UEFI compatible." Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARTE 4 : Réinitialisation BCD -->
                <Border Background="#1A2234" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔧" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Réinitialiser / Réparer le menu de démarrage (BCD)" FontWeight="SemiBold" FontSize="15" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Reconstruit la configuration BCD avec BCDBoot et supprime tout blocage ou boucle de démarrage sans échec résiduelle."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Réparer le magasin BCD" Style="{StaticResource PrimaryActionButton}" Click="BtnRepairBcd_Click"/>
                            <TextBlock Text="Opération sans risque sur le système en place." Foreground="#34D399" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Console de journalisation -->
        <Border Grid.Row="3" Background="#0A0E17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBox x:Name="TxtConsole"
                     IsReadOnly="True"
                     Background="Transparent"
                     Foreground="#38BDF8"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="Prêt. Sélectionnez une action de démarrage ou de récupération."/>
        </Border>

        <!-- 5. Pied de page -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="ℹ️ Toutes les actions nécessitent les privilèges d'administrateur Windows."
                       Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Fermer" Style="{StaticResource ActionButton}" Width="90" Click="BtnClose_Click" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
