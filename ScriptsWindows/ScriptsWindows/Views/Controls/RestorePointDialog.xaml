<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.RestorePointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Points de Restauration Système"
        Width="640" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔄" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestion des Points de Restauration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Créez des points de sauvegarde pour sécuriser votre système avant toute modification majeure."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Création d'un nouveau point -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Créer un nouveau point de restauration :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPointDescription" Height="36" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderStrong}" Padding="8,8" Text="Point de sauvegarde AlexToolkit" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnCreatePoint" Content="➕ Créer le point" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryActionButton}" Click="BtnCreatePoint_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Liste des points existants -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="POINTS DE RESTAURATION EXISTANTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button Content="🔄 Actualiser" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnRefresh_Click"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="LstRestorePoints" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}"
                         Foreground="{DynamicResource TextPrimary}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateStr}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Outil graphique Windows -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Button Content="🛡️ Ouvrir l'Assistant de Restauration Système Windows (rstrui.exe)"
                    Style="{StaticResource ActionButton}" Click="BtnOpenRstrui_Click"/>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="4">
            <TextBlock x:Name="TxtFeedback" Text="" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
