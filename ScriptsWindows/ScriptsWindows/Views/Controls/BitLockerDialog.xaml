<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.BitLockerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du chiffrement BitLocker"
        Width="600" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>


    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestion du Chiffrement BitLocker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Visualisez l'état de vos disques, sélectionnez le volume souhaité et gérez sa protection."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Sélection du disque -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Lecteur à gérer :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbDrives" Height="36" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderStrong}" SelectionChanged="CmbDrives_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRefresh" Content="🔄 Actualiser" Margin="12,22,0,0"
                        Style="{StaticResource ActionButton}" Padding="10,6" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Carte de statut du lecteur -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ÉTAT ACTUEL DU LECTEUR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Protection :" Foreground="{DynamicResource TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="BadgeProtection" CornerRadius="4" Padding="8,2" Background="{DynamicResource BgInput}">
                            <TextBlock x:Name="TxtProtectionStatus" Text="Analyse..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Chiffrement :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtEncryptionMethod" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Avancement :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtPercentEncrypted" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Type de volume :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtVolumeType" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions disponibles -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bouton Activer -->
            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnEnable" Margin="0,0,6,8"
                    Content="🔒 Activer BitLocker" Style="{StaticResource PrimaryActionButton}"
                    Click="BtnEnable_Click"/>

            <!-- Bouton Désactiver -->
            <Button Grid.Row="0" Grid.Column="1" x:Name="BtnDisable" Margin="6,0,0,8"
                    Content="🔓 Désactiver BitLocker" Style="{StaticResource DangerActionButton}"
                    Click="BtnDisable_Click"/>

            <!-- Bouton Suspendre / Reprendre -->
            <Button Grid.Row="1" Grid.Column="0" x:Name="BtnSuspend" Margin="0,0,6,0"
                    Content="⏸️ Suspendre protection" Style="{StaticResource ActionButton}"
                    Click="BtnSuspend_Click"/>

            <!-- Bouton Panneau Windows -->
            <Button Grid.Row="1" Grid.Column="1" x:Name="BtnOpenPanel" Margin="6,0,0,0"
                    Content="⚙️ Panneau Windows BitLocker" Style="{StaticResource ActionButton}"
                    Click="BtnOpenPanel_Click"/>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="4">
            <TextBlock x:Name="TxtFeedback" Text="" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
