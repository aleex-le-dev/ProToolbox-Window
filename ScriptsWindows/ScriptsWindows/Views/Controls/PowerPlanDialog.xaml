<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.PowerPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Plans d'Alimentation"
        Width="680" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>



    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Background="{DynamicResource BgCard}" CornerRadius="10" Padding="10" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Gestion des Plans d'Alimentation" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Basculez entre le mode normal/équilibré et les performances élevées à volonté."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Bandeau état actif -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <TextBlock Text="PLAN ACTIF :" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtActivePlanBadge" Text="Détection en cours..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Liste des plans d'alimentation disponibles -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PlansItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <!-- Bouton Activer à droite -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border x:Name="BadgeActif"
                                                Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource Success}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                                                Visibility="{Binding IsActiveVisibility}">
                                            <TextBlock Text="✓ ACTIF" Foreground="{DynamicResource SuccessText}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Button Content="Activer ce plan"
                                                Style="{StaticResource ActionButton}"
                                                Padding="12,6" FontSize="12"
                                                Tag="{Binding Guid}"
                                                IsEnabled="{Binding CanActivate}"
                                                Click="BtnActivatePlan_Click"/>
                                    </StackPanel>

                                    <!-- Icône et Infos du plan -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Boutons de raccourcis rapides -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ACTIONS RAPIDES EN 1 CLIC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SuccessActionButton}"
                            Click="BtnSetBalanced_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚖️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mode Normal (Équilibré)" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryActionButton}"
                            Click="BtnSetHigh_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🚀" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hautes Performances" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource OrangeActionButton}"
                            Click="BtnSetUltimate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Performances Ultimes" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Barre de statut et bouton Fermer -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Width="90" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Text="Prêt." FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
