<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.SystemIntegrityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre d'Intégrité et Réparation Système (DISM &amp; SFC)"
        Width="680" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🩺" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Centre d'Intégrité Windows (DISM &amp; SFC)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Diagnostiquez, réparez l'image système Windows et restaurez l'intégrité des fichiers système protégés."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Liste des options de réparation -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel Margin="0,0,4,0">
                <!-- Option 1 : Pipeline Curatif Recommandé -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🩹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pipeline curatif complet (DISM + SFC)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentDim}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="RECOMMANDÉ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Enchaîne automatiquement la réparation de l'image en ligne (DISM /RestoreHealth) puis le scan d'intégrité (SFC /scannow). Cure complète 100% automatisée."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunPipeline" Content="🚀 Lancer la cure complète" Style="{StaticResource PrimaryActionButton}"
                                Padding="14,10" VerticalAlignment="Center" Click="BtnRunPipeline_Click"/>
                    </Grid>
                </Border>

                <!-- Option 2 : ScanHealth -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔎" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vérification de l'image (DISM /ScanHealth)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Analyse l'image Windows pour détecter d'éventuelles corruptions sans modifier le système (1 à 3 min)."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunScanHealth" Content="Lancer l'analyse" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunScanHealth_Click"/>
                    </Grid>
                </Border>

                <!-- Option 3 : RestoreHealth -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🩺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Restauration de l'image (DISM /RestoreHealth)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Répare l'image système Windows en téléchargeant les composants officiels nécessaires via Windows Update (3 à 8 min)."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunRestoreHealth" Content="Réparer l'image" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunRestoreHealth_Click"/>
                    </Grid>
                </Border>

                <!-- Option 4 : SFC scannow -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vérification des fichiers système (SFC /scannow)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Analyse et répare immédiatement les fichiers système Windows corrompus ou modifiés (5 à 12 min)."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunSfc" Content="Lancer SFC" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunSfc_Click"/>
                    </Grid>
                </Border>

                <!-- Option 5 : Windows Update (état + réinitialisation des composants) -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource FontIcon}" FontSize="15" Foreground="{DynamicResource AccentText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Windows Update bloqué ou en erreur" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Affiche l'état des services, les dernières mises à jour et les échecs récents. La réinitialisation arrête les services, recrée les caches SoftwareDistribution et catroot2 puis relance tout (corrige la plupart des erreurs 0x80…)."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnWuStatus" Content="État" Style="{StaticResource ActionButton}"
                                    Padding="14,8" Margin="0,0,8,0" Click="BtnWuStatus_Click"/>
                            <Button x:Name="BtnWuReset" Content="Réinitialiser" Style="{StaticResource WarningActionButton}"
                                    Padding="14,8" Click="BtnWuReset_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre de progression et Statut -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgBar" Grid.Row="0" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="{DynamicResource BgCard}" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtStatus" Text="Prêt. Choisissez un mode de vérification ou de réparation." Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
