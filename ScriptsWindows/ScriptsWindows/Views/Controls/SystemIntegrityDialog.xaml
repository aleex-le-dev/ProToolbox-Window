<Window x:Class="ScriptsWindows.Views.Controls.SystemIntegrityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre d'Intégrité et Réparation Système (DISM &amp; SFC)"
        Width="680" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🩺" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Centre d'Intégrité Windows (DISM &amp; SFC)" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Diagnostiquez, réparez l'image système Windows et restaurez l'intégrité des fichiers système protégés."
                       Foreground="#9CA3AF" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Liste des options de réparation -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel Margin="0,0,4,0">
                <!-- Option 1 : Pipeline Curatif Recommandé -->
                <Border Background="#1F2937" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🩹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pipeline curatif complet (DISM + SFC)" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                                <Border Background="#2E1065" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="RECOMMANDÉ" FontSize="9" FontWeight="Bold" Foreground="#C4B5FD"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Enchaîne automatiquement la réparation de l'image en ligne (DISM /RestoreHealth) puis le scan d'intégrité (SFC /scannow). Cure complète 100% automatisée."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunPipeline" Content="🚀 Lancer la cure complète" Style="{StaticResource PrimaryActionButton}"
                                Padding="14,10" VerticalAlignment="Center" Click="BtnRunPipeline_Click"/>
                    </Grid>
                </Border>

                <!-- Option 2 : ScanHealth -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔎" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vérification de l'image (DISM /ScanHealth)" FontWeight="Bold" FontSize="13" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Analyse l'image Windows pour détecter d'éventuelles corruptions sans modifier le système (1 à 3 min)."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunScanHealth" Content="Lancer l'analyse" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunScanHealth_Click"/>
                    </Grid>
                </Border>

                <!-- Option 3 : RestoreHealth -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🩺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Restauration de l'image (DISM /RestoreHealth)" FontWeight="Bold" FontSize="13" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Répare l'image système Windows en téléchargeant les composants officiels nécessaires via Windows Update (3 à 8 min)."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunRestoreHealth" Content="Réparer l'image" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunRestoreHealth_Click"/>
                    </Grid>
                </Border>

                <!-- Option 4 : SFC scannow -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vérification des fichiers système (SFC /scannow)" FontWeight="Bold" FontSize="13" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Analyse et répare immédiatement les fichiers système Windows corrompus ou modifiés (5 à 12 min)."
                                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRunSfc" Content="Lancer SFC" Style="{StaticResource ActionButton}"
                                Padding="14,8" VerticalAlignment="Center" Click="BtnRunSfc_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre de progression et Statut -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgBar" Grid.Row="0" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="#1F2937" Foreground="#6366F1" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtStatus" Text="Prêt. Choisissez un mode de vérification ou de réparation." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
