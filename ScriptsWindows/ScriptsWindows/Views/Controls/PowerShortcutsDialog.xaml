<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.PowerShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boutons d'Arrêt et Redémarrage sur le Bureau"
        Width="680" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style de bouton standard -->

        <!-- Style Rouge (Arrêt) -->

        <!-- Style Bleu (Redémarrer) -->

        <!-- Style Vert (Action globale) -->
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Border Background="{DynamicResource BgCard}" CornerRadius="10" Padding="12" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Boutons d'Arrêt et Redémarrage sur le Bureau" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Créez des boutons raccourcis avec les icônes officielles Windows pour éteindre ou redémarrer immédiatement en 1 clic."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Cartes des raccourcis -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel>
                <!-- Carte 1 : Arrêter le PC -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <!-- Actions à droite -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BtnDeleteShutdown" Content="🗑️" ToolTip="Supprimer le raccourci du Bureau"
                                    Style="{StaticResource ActionButton}" Padding="10,6" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="BtnDeleteShutdown_Click"/>
                            <Button x:Name="BtnCreateShutdown" Content="📌 Mettre sur le Bureau"
                                    Style="{StaticResource DangerActionButton}" FontSize="12.5"
                                    Click="BtnCreateShutdown_Click"/>
                        </StackPanel>

                        <!-- Icône et Infos -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="8" Width="46" Height="46" Margin="0,0,14,0">
                                <TextBlock Text="🔴" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Arrêter le PC" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Border x:Name="BadgeShutdownStatus" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtShutdownStatus" Text="Non installé" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Éteint immédiatement l'ordinateur en fermant proprement toutes vos applications."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="Icône officielle Windows Power rouge (shell32.dll, 27)"
                                           FontSize="11" Foreground="{DynamicResource DangerText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Carte 2 : Redémarrer le PC -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel LastChildFill="True">
                        <!-- Actions à droite -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BtnDeleteRestart" Content="🗑️" ToolTip="Supprimer le raccourci du Bureau"
                                    Style="{StaticResource ActionButton}" Padding="10,6" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="BtnDeleteRestart_Click"/>
                            <Button x:Name="BtnCreateRestart" Content="📌 Mettre sur le Bureau"
                                    Style="{StaticResource PrimaryActionButton}" FontSize="12.5"
                                    Click="BtnCreateRestart_Click"/>
                        </StackPanel>

                        <!-- Icône et Infos -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentDim}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Width="46" Height="46" Margin="0,0,14,0">
                                <TextBlock Text="🔄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Redémarrer le PC" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Border x:Name="BadgeRestartStatus" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRestartStatus" Text="Non installé" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Redémarre immédiatement l'ordinateur en 1 clic."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="Icône officielle Windows Redémarrer flèche bleue (shell32.dll, 238)"
                                           FontSize="11" Foreground="{DynamicResource AccentText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Barre d'actions -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnCreateAll" Content="⚡ Créer Arrêter &amp; Redémarrer en 1 clic"
                        Style="{StaticResource SuccessActionButton}" FontSize="12.5" Padding="16,8"
                        Click="BtnCreateAll_Click"/>
                <Button Content="Fermer" DockPanel.Dock="Right"
                        Style="{StaticResource ActionButton}" Padding="18,8" FontSize="12"
                        Click="BtnClose_Click"/>
            </DockPanel>
        </Border>

        <!-- 4. Barre de statut -->
        <Border Grid.Row="3" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ℹ️" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="Prêt. Cliquez sur le bouton souhaité pour le placer sur votre Bureau."
                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
