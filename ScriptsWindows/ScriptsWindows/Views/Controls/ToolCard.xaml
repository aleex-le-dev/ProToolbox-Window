<UserControl x:Class="ScriptsWindows.Views.Controls.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="320">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="Margin" Value="6,6,8,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" 
                                      BlurRadius="{DynamicResource CardShadowBlur}" 
                                      Opacity="{DynamicResource CardShadowOpacity}" 
                                      Direction="270" 
                                      ShadowDepth="2" 
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}" Width="316" Height="144">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête : Badge Icône, Titre, Bouton Favori -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Badge Icône Moderne façon Raycast/Linear -->
                <Border Background="{DynamicResource AccentDim}" 
                        CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Titre de l'outil -->
                <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="Titre de l'outil" 
                           FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Favori -->
                <Button x:Name="BtnFavorite" Grid.Column="2" 
                        Background="Transparent" BorderThickness="0" 
                        Foreground="{DynamicResource TextSecondary}" FontSize="14" Cursor="Hand"
                        Click="BtnFavorite_Click" Padding="4,2" ToolTip="Ajouter / Retirer des favoris">
                    <TextBlock x:Name="TxtFavIcon" Text="☆"/>
                </Button>
            </Grid>

            <!-- Description -->
            <TextBlock x:Name="TxtDescription" Grid.Row="1" Margin="0,8,0,6"
                       Text="Description concise de la fonction de l'outil." 
                       Foreground="{DynamicResource TextSecondary}" FontSize="11.5" LineHeight="16"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>

            <!-- Pied : Badge Admin & Bouton Exécuter -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Badge Admin Pilule Moderne -->
                <Border x:Name="BadgeAdmin" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="#1EF43F5E" BorderBrush="#3EF43F5E" BorderThickness="1" CornerRadius="5" Padding="6,2">
                    <TextBlock Text="🛡️ Admin" FontSize="10" Foreground="#FDA4AF" FontWeight="SemiBold"/>
                </Border>

                <!-- Bouton Lancer avec icône de lecture -->
                <Button x:Name="BtnRun" Grid.Column="1" Click="BtnRun_Click"
                        Content="▶ Exécuter" FontSize="11.5" FontWeight="SemiBold"
                        Padding="12,5" Cursor="Hand"
                        Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
