<UserControl x:Class="ScriptsWindows.Views.Controls.ToolCard"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              mc:Ignorable="d" 
              d:DesignHeight="148" d:DesignWidth="320"
              Width="320" Height="148" Margin="0,0,14,14">
    <UserControl.Resources>
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" 
                                      BlurRadius="8" 
                                      Opacity="0.2" 
                                      Direction="270" 
                                      ShadowDepth="1" 
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ModernCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 1. En-tête : Icône, Titre, Favori -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Description -->
                <RowDefinition Height="*"/>
                <!-- 3. Pied de carte : Bouton Exécuter -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. En-tête -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Badge Icône moderne -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource AccentDim}" 
                        CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="⚡" FontSize="17" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Titre de l'outil -->
                <TextBlock x:Name="TxtTitle" Grid.Column="1"
                           Text="Titre de l'outil" 
                           FontWeight="SemiBold" FontSize="13.5" 
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Favori officiel Windows (police native Segoe MDL2 Assets, nette et sans vecteur) -->
                <Button x:Name="BtnFavorite" Grid.Column="2"
                        Background="Transparent" BorderThickness="0" 
                        Cursor="Hand" Click="BtnFavorite_Click" 
                        Padding="6,4" VerticalAlignment="Top" Margin="4,-2,0,0"
                        ToolTip="Ajouter / Retirer des favoris">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock x:Name="TxtFavIcon"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Text="&#xE734;"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- 2. Description -->
            <TextBlock x:Name="TxtDescription" Grid.Row="1"
                       Text="Description concise de la fonction de l'outil." 
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top" Margin="0,2,0,4"/>

            <!-- 3. Pied : Badge Catégorie à gauche (si activé) + Bouton Exécuter à droite -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <Border x:Name="BadgeCategory"
                        DockPanel.Dock="Left"
                        Background="{DynamicResource BgInput}"
                        CornerRadius="6"
                        Padding="7,3,7,3"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtCategory"
                               Text="Catégorie"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}" />
                </Border>
                <Button x:Name="BtnRun" DockPanel.Dock="Right" Click="BtnRun_Click"
                        Content="▶ Exécuter" FontSize="11.5" FontWeight="SemiBold"
                        Padding="14,6" Cursor="Hand"
                        Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
