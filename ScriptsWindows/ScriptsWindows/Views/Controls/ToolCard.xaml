<UserControl x:Class="ScriptsWindows.Views.Controls.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="215" d:DesignWidth="325"
             Width="325" Height="215" Margin="0,0,12,12">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="16,14,16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                    <Setter Property="Background"  Value="{DynamicResource BgCardHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- En-tête -->
                <RowDefinition Height="Auto"/>  <!-- Description -->
                <RowDefinition Height="*"/>     <!-- Points clés -->
                <RowDefinition Height="Auto"/>  <!-- Pied -->
            </Grid.RowDefinitions>

            <!-- En-tête : icône de catégorie, titre, favori -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource AccentDim}"
                        CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="&#xE713;" FontSize="16"
                               FontFamily="{StaticResource FontIcon}"
                               Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TxtTitle" Grid.Column="1"
                           Text="Titre de l'outil"
                           FontFamily="{StaticResource FontDisplay}"
                           FontWeight="SemiBold" FontSize="13.5"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" MaxHeight="38"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnFavorite" Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Click="BtnFavorite_Click"
                        VerticalAlignment="Top" Margin="6,-4,-6,0"
                        ToolTip="Ajouter aux favoris">
                    <TextBlock x:Name="TxtFavIcon"
                               FontFamily="{StaticResource FontIcon}"
                               FontSize="14"
                               Text="&#xE734;"
                               Foreground="{DynamicResource TextMuted}" />
                </Button>
            </Grid>

            <!-- Description -->
            <TextBlock x:Name="TxtDescription" Grid.Row="1"
                       Text="Description concise de la fonction de l'outil."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                       LineHeight="17"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="34" VerticalAlignment="Top" Margin="0,0,0,6"/>

            <!-- Points clés (générés par le code) -->
            <StackPanel x:Name="PanelFeatures" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,6"/>

            <!-- Pied : catégorie (vue Favoris) + actions -->
            <DockPanel Grid.Row="3" LastChildFill="False">
                <Border x:Name="BadgeCategory"
                        DockPanel.Dock="Left"
                        Style="{StaticResource CategoryBadge}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtCategory"
                               Text="Catégorie"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDesktop" Click="BtnDesktop_Click"
                            Style="{StaticResource ActionButton}"
                            FontSize="12" Padding="10,4" MinHeight="28" Margin="0,0,8,0"
                            ToolTip="Créer sur le Bureau un script autonome qui lance ce nettoyage en un double-clic"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource FontIcon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bureau" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRun" Click="BtnRun_Click"
                            Style="{StaticResource PrimaryActionButton}"
                            Content="Exécuter"
                            FontSize="12" Padding="14,4" MinHeight="28" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
