<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.WebsiteAnalyzerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre d'Audit &amp; Analyseur de Site Web Complet"
        Width="1160" Height="880"
        MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Centre d'Audit &amp; Analyseur de Site Web Complet" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Interface unifiée : Synthèse Globale • Checklist 21 Points • Speedtest Serveur • Studio SEO &amp; SERP • Extracteur de Mots-Clés • SSL, DNS &amp; Liens"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderStatusBadge" Text="✨ Prêt pour l'analyse" Foreground="{DynamicResource AccentText}" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <!-- 1. BARRE D'URL AVEC PRÉFIXE HTTPS:// FIXE À GAUCHE + BARRE DE PROGRESSION -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔗 Domaine / URL :" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,10,0"/>

                    <!-- Champ combiné : badge fixe "https://" à gauche + saisie directe à droite -->
                    <Border Grid.Column="1" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" CornerRadius="5,0,0,5" Padding="10,7">
                                <TextBlock Text="https://" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock x:Name="TxtPlaceholder"
                                           Text="salutalex.fr"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtUrl"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource AccentText}"
                                         BorderThickness="0"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Padding="0,6"
                                         TextChanged="TxtUrl_TextChanged"
                                         KeyDown="TxtUrl_KeyDown"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnAnalyze"
                            Grid.Column="2"
                            Content="🚀 Lancer l'analyse complète"
                            Style="{StaticResource PrimaryActionButton}"
                            Padding="16,8"
                            FontSize="13"
                            Margin="0,0,8,0"
                            Click="BtnAnalyze_Click"/>

                    <Button x:Name="BtnCancelAudit"
                            Grid.Column="3"
                            Content="⏹ Stop"
                            Visibility="Collapsed"
                            ToolTip="Arrêter immédiatement l'analyse en cours"
                            Style="{StaticResource ActionButton}"
                            BorderBrush="{DynamicResource Danger}"
                            Foreground="{DynamicResource DangerText}"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            Click="BtnCancelAudit_Click"/>

                    <Button x:Name="BtnQuickSpeedtest"
                            Grid.Column="4"
                            Content="⚡ Speedtest (5x)"
                            ToolTip="Exécuter un benchmark rapide de 5 salves HTTP sur ce domaine"
                            Style="{StaticResource ActionButton}"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            Click="BtnRunSpeedtestOnly_Click"/>

                    <Button x:Name="BtnOpenSite"
                            Grid.Column="5"
                            Content="↗ Ouvrir"
                            ToolTip="Ouvrir le site dans le navigateur"
                            Style="{StaticResource ActionButton}"
                            Padding="12,8"
                            Click="BtnOpenSite_Click"/>
                </Grid>

                <!-- Barre de progression temps réel du moteur parallèle -->
                <ProgressBar x:Name="BarAuditProgress"
                             Visibility="Collapsed"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="{DynamicResource BgDeep}"
                             Foreground="{DynamicResource AccentText}"
                             BorderThickness="0"
                             Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. BANDEAU DES 4 INDICATEURS CLÉS (KPI EN TEMPS RÉEL) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Carte 1 : Score Global -->
            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="🏆 SCORE &amp; NOTE GLOBALE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="TxtScoreValue" Text="-- / 21 (--%)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtScoreSub" Text="En attente d'analyse" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Carte 2 : Vitesse & Serveur -->
            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="⚡ SPEEDTEST &amp; LATENCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="TxtPerfValue" Text="-- ms" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2"/>
                    <TextBlock x:Name="TxtPerfSub" Text="DNS, TLS, TTFB &amp; Poids" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Carte 3 : Certificat SSL & Sécurité -->
            <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="🔒 SSL/TLS &amp; SÉCURITÉ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="TxtSslValue" Text="Non vérifié" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSslSub" Text="Validité TLS &amp; HSTS / CSP" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Carte 4 : SEO & Mots-Clés -->
            <Border Grid.Column="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="🔍 SEO &amp; MOTS-CLÉS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="TxtMediaValue" Text="-- mots / -- Hn" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtMediaSub" Text="Titres Hn, Images &amp; Liens" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. BARRE DE NAVIGATION UNIFIÉE (6 ONGLETS PLEINE LARGEUR) -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnTabOverview" Content="📊 1. Vue d'Ensemble" Style="{StaticResource PrimaryActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabOverview_Click"/>
                <Button Grid.Column="1" x:Name="BtnTabChecklist" Content="📋 2. Checklist (21)" Style="{StaticResource ActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabChecklist_Click"/>
                <Button Grid.Column="2" x:Name="BtnTabSpeedtest" Content="⚡ 3. Speedtest &amp; Perf" Style="{StaticResource ActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabSpeedtest_Click"/>
                <Button Grid.Column="3" x:Name="BtnTabSeo" Content="🔍 4. SEO &amp; SERP" Style="{StaticResource ActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabSeo_Click"/>
                <Button Grid.Column="4" x:Name="BtnTabKeywords" Content="🔑 5. Mots-Clés" Style="{StaticResource ActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabKeywords_Click"/>
                <Button Grid.Column="5" x:Name="BtnTabNetwork" Content="🛡️ 6. Réseau, SSL &amp; Liens" Style="{StaticResource ActionButton}" Margin="2" Padding="8,7" FontSize="11.5" Click="BtnTabNetwork_Click"/>
            </Grid>
        </Border>

        <!-- 4. ZONE DE CONTENU DYNAMIQUE DES 6 SECTIONS -->
        <Grid Grid.Row="4">

            <!-- ========================================================================= -->
            <!-- SECTION 0 : VUE D'ENSEMBLE & TABLEAU DE BORD EXÉCUTIF                     -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelOverview" Visibility="Visible" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Ligne supérieure : Note Globale + 4 Piliers -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge Note A+ à D -->
                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="NOTE GLOBALE DU SITE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <Border x:Name="BorderGradeBadge" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="40" Width="76" Height="76" Margin="0,10,0,8">
                                        <TextBlock x:Name="TxtOverviewGrade" Text="--" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtOverviewVerdict" Text="En attente d'analyse" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Scores par Pilier (4 barres) -->
                            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📈 Diagnostic par Pilier (Conformité, Performance, SEO, Sécurité)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="⚖️ 1. Conformité Légale &amp; RGPD (RGPD, CGU, Cookies)" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtPillarLegal" Text="--%" DockPanel.Dock="Right" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarPillarLegal" Height="7" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource AccentText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="⚡ 2. Performance, Vitesse &amp; Médias (TTFB, Images, Responsive, Liens)" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtPillarPerf" Text="--%" DockPanel.Dock="Right" Foreground="{DynamicResource SuccessText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarPillarPerf" Height="7" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource SuccessText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="🔍 3. Référencement SEO &amp; Structure (Title, OG, Sitemap, Alt, H1, Analytics)" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtPillarSeo" Text="--%" DockPanel.Dock="Right" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarPillarSeo" Height="7" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource AccentText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="🛡️ 4. Sécurité, SSL/TLS &amp; Formulaires (HTTPS, Clés API, Anti-spam, En-têtes)" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtPillarSec" Text="--%" DockPanel.Dock="Right" Foreground="{DynamicResource WarningText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarPillarSec" Height="7" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource WarningText}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Ligne médiane : Plan d'action prioritaire + Résumé Speedtest & Top Mots-Clés -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Plan d'action prioritaire -->
                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="🚨 Plan d'Action Prioritaire (Points à corriger en premier)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        <Button Content="Voir les 21 points ➔" Style="{StaticResource ActionButton}" Padding="8,3" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnTabChecklist_Click"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="ItemsOverviewPriorities">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgDeep}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusFg}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="{DynamicResource AccentText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Aperçu combiné : Top 5 Mots-Clés + Bilan Speedtest -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="🔑 Top 5 Mots-Clés Dominants" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Content="Détails Mots-Clés ➔" Style="{StaticResource ActionButton}" Padding="8,3" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnTabKeywords_Click"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtOverviewTopKeywords"
                                                   Text="Lancez l'analyse pour extraire les mots-clés principaux et leur densité SEO."
                                                   FontFamily="Consolas"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="⚡ Synthèse Speedtest &amp; Aperçu SEO" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Content="Ouvrir Speedtest ➔" Style="{StaticResource ActionButton}" Padding="8,3" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnTabSpeedtest_Click"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtOverviewSpeedAndSeo"
                                                   Text="• DNS : -- ms | TLS : -- ms | TTFB : -- ms&#x0a;• Title SEO : --&#x0a;• Structure Hn : --"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SECTION 1 : CHECKLIST PRÉ-LANCEMENT (21 POINTS)                           -->
            <!-- ========================================================================= -->
            <Grid x:Name="PanelChecklist" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterAll" Content="Tous (21)" Style="{StaticResource PrimaryActionButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnFilterAll_Click"/>
                            <Button x:Name="BtnFilterFail" Content="❌ Manquants (0)" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnFilterFail_Click"/>
                            <Button x:Name="BtnFilterWarn" Content="⚠️ À optimiser (0)" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnFilterWarn_Click"/>
                            <Button x:Name="BtnFilterOk" Content="✅ Conformes (0)" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11" Click="BtnFilterOk_Click"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Left" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="5" Width="210" Margin="0,0,10,0" Padding="6,3">
                            <DockPanel>
                                <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearchChecklist"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource AccentText}"
                                         BorderThickness="0"
                                         FontSize="11.5"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Filtrer les 21 contrôles par mot-clé (ex: RGPD, SEO, HTTPS...)"
                                         TextChanged="TxtSearchChecklist_TextChanged"/>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="TxtSummaryDetails"
                                   Text="Filtrez ou recherchez parmi les 21 contrôles ci-dessous."
                                   Foreground="{DynamicResource TextPrimary}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="ItemsChecks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="215"/>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource BgDeep}" CornerRadius="5" Width="26" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{Binding StatusBg}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,10,0">
                                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusFg}"/>
                                            </Border>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Recommendation}"
                                                           Visibility="{Binding HasRecommendationVisibility}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentText}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- SECTION 2 : SPEEDTEST & PERFORMANCE SERVEUR                               -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelSpeedtest" Visibility="Collapsed" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Speedtest Web &amp; Décomposition de Latence (DNS / TCP+TLS / TTFB / Débit)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Mesure chronométrée de chaque étape réseau et test de stabilité sur 5 requêtes consécutives." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnRunSpeedtestOnly"
                                    DockPanel.Dock="Right"
                                    Content="⚡ Relancer un Speedtest (5 salves)"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Padding="14,7"
                                    Click="BtnRunSpeedtestOnly_Click"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="1. RÉSOLUTION DNS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtSpeedDns" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtSpeedDnsSub" Text="Recherche d'adresse IP" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="2. CONNEXION TCP + SSL/TLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtSpeedTls" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtSpeedTlsSub" Text="Handshake chiffré port 443" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="3. ATTENTE SERVEUR (TTFB)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtSpeedTtfb" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtSpeedTtfbSub" Text="Time To First Byte HTTP" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="4. TÉLÉCHARGEMENT &amp; DÉBIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtSpeedTransfer" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningText}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtSpeedThroughput" Text="Débit : -- Ko/s" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="📊 Chronologie d'exécution de la requête (Waterfall)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Résolution DNS" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtBarDnsLabel" Text="-- ms" DockPanel.Dock="Right" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarSpeedDns" Height="8" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource AccentText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Connexion TCP + Handshake TLS" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtBarTlsLabel" Text="-- ms" DockPanel.Dock="Right" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarSpeedTls" Height="8" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource AccentText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Traitement Serveur (TTFB)" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtBarTtfbLabel" Text="-- ms" DockPanel.Dock="Right" Foreground="{DynamicResource SuccessText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarSpeedTtfb" Height="8" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource SuccessText}" BorderThickness="0" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Téléchargement du flux HTML" Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtBarTransferLabel" Text="-- ms" DockPanel.Dock="Right" Foreground="{DynamicResource WarningText}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarSpeedTransfer" Height="8" Maximum="100" Value="0" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource WarningText}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🎯 Benchmark de Stabilité (Salves HTTP)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtSpeedPingStats"
                                               Text="Lancez l'analyse ou cliquez sur « Speedtest (5x) » pour mesurer la latence Min / Moyenne / Max et la gigue (Jitter)."
                                               Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <TextBlock x:Name="TxtSpeedSamplesList"
                                                   Text="En attente de mesure..."
                                                   FontFamily="Consolas"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AccentText}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="📦 Répartition du Poids &amp; des Ressources" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtSpeedWeightBreakdown"
                                               Text="HTML : -- Ko | Scripts JS : -- | Feuilles CSS : -- | Images : --"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="📶 Temps de chargement estimé selon le réseau client" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtSpeedNetworkSim"
                                               Text="• Fibre (100 Mbps) : --&#x0a;• 4G Mobile (20 Mbps) : --&#x0a;• 3G / Réseau lent (3 Mbps) : --"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SECTION 3 : OUTILS SEO, APERÇU GOOGLE SERP & ARBORESCENCE H1-H6           -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelSeo" Visibility="Collapsed" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="🔍 Aperçu dans les Résultats Google (SERP Preview)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtSerpUrl" Text="https://salutalex.fr" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtSerpTitle" Text="Titre de la page dans Google Search" Foreground="{DynamicResource AccentText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtSerpDesc" Text="Votre meta description s'affichera ici telle que les internautes la verront sur Google. Visez entre 120 et 160 caractères pour éviter toute troncature." Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSerpMetrics" Text="Longueur Title : --/60 car. • Longueur Description : --/160 car." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📣 Carte Réseaux Sociaux (Open Graph) &amp; Indexation" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtOgPreviewTitle" Text="og:title — Non renseigné" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtOgPreviewDesc" Text="og:description — Non renseignée" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtOgPreviewImg" Text="og:image — Aucune image déclarée" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSeoTechDetails"
                                               Text="• Canonical : --&#x0a;• Meta Robots : --&#x0a;• Données structurées JSON-LD : --&#x0a;• Ratio Texte / HTML : --"
                                               FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="📑 Structure Sémantique &amp; Hiérarchie des Titres (H1 à H6)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtHeadingsSummary" Text="-- balises Hn détectées" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"/>
                                </DockPanel>

                                <ItemsControl x:Name="ItemsHeadings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="{Binding IndentMargin}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tag}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource OnAccent}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SECTION 4 : MOTS-CLÉS, DENSITÉ LEXICALE & TESTEUR DE MOT-CLÉ CIBLE        -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelKeywords" Visibility="Collapsed" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎯 Tester un mot-clé cible :" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtTargetKeyword"
                                         Grid.Column="1"
                                         Background="{DynamicResource BgDeep}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource AccentText}"
                                         BorderBrush="{DynamicResource BorderStrong}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="12.5"
                                         Margin="0,0,8,0"
                                         KeyDown="TxtTargetKeyword_KeyDown"/>
                                <Button Grid.Column="2"
                                        Content="🔎 Vérifier le score SEO de ce mot-clé"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Padding="12,6"
                                        Click="BtnCheckKeyword_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtTargetKeywordResult"
                                       Text="Astuce : tapez un mot ou une expression (ex: votre activité ou ville) pour vérifier s'il est bien placé dans le Title, H1, Meta Description, URL et corps du texte."
                                       Foreground="{DynamicResource AccentText}"
                                       FontSize="11.5"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnKw1" Content="1 Mot (Mots-Clés)" Style="{StaticResource PrimaryActionButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="BtnKw1_Click"/>
                            <Button x:Name="BtnKw2" Content="2 Mots (Bigrammes)" Style="{StaticResource ActionButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Click="BtnKw2_Click"/>
                            <Button x:Name="BtnKw3" Content="3 Mots (Expressions)" Style="{StaticResource ActionButton}" Padding="10,5" FontSize="11.5" Click="BtnKw3_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtWordCountSummary"
                                   DockPanel.Dock="Right"
                                   Text="Total : -- mots • Vocabulaire unique : -- mots • Lecture : ~-- min"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="ItemsKeywords">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Word}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DensityText}" FontSize="12" Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Locations}" FontSize="11.5" Foreground="{DynamicResource WarningText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- SECTION 5 : RÉSEAU, DNS, CERTIFICAT SSL, HEADERS & LIENS                  -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelNetwork" Visibility="Collapsed" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="🌐 Diagnostic DNS, IP &amp; Infrastructure Serveur" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtNetDnsInfo"
                                               Text="Lancez une analyse pour afficher les adresses IPv4/IPv6, le Reverse DNS, le protocole HTTP et le serveur web."
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔒 Certificat SSL / TLS (X.509)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtNetSslInfo"
                                               Text="Lancez une analyse pour inspecter le certificat SSL (Émetteur, Sujet, Expiration, Empreinte SHA-256)."
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Explorateur des Liens Vérifiés en Parallèle -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔗 Liens de la page inspectés en parallèle (Statut HTTP &amp; Temps de réponse)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ItemsInspectedLinks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding StatusFg}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Scope}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Url}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- En-têtes HTTP complets -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🛡️ En-têtes HTTP renvoyés par le serveur (Response &amp; Content Headers)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ItemsHeaders">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- 5. PIED DE PAGE -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BtnCopyReport" Content="📋 Copier le rapport complet (Synthèse + 21 Points + Speedtest + SEO + Mots-Clés)" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnCopyReport_Click"/>
                <Button x:Name="BtnExportReport" Content="💾 Exporter le bilan (.md / .txt)" Style="{StaticResource ActionButton}" Click="BtnExportReport_Click"/>
            </StackPanel>

            <Button Content="Fermer" Style="{StaticResource ActionButton}" Width="95" DockPanel.Dock="Right" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
