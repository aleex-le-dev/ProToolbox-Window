<Window x:Class="ScriptsWindows.Views.Controls.SecurityCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre de Surveillance et Sécurité"
        Width="780" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Centre de Surveillance et Sécurité" FontSize="19" FontWeight="Bold" Foreground="#F9FAFB"/>
                    <TextBlock Text="Protection Windows Defender, analyse des erreurs critiques, fiabilité noyau et consommation des processus."
                               Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de navigation par onglets -->
        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="4" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnTabDefender" Content="🛡️ Antivirus &amp; Defender"
                        Click="TabButton_Click" Tag="TabDefender" Margin="2" Padding="8,8"
                        Background="#4F46E5" Foreground="#F9FAFB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="1" x:Name="BtnTabEvents" Content="⚠️ Erreurs &amp; Plantages"
                        Click="TabButton_Click" Tag="TabEvents" Margin="2" Padding="8,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="2" x:Name="BtnTabRam" Content="📈 Top Processus RAM"
                        Click="TabButton_Click" Tag="TabRam" Margin="2" Padding="8,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Zone de contenu des onglets -->
        <Grid Grid.Row="2" Margin="0,0,0,14">

            <!-- ONGLET 1 : DEFENDER & ANTIVIRUS -->
            <Grid x:Name="PanelDefender" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Carte d'état de protection Defender -->
                <Border Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ÉTAT DE LA PROTECTION WINDOWS DEFENDER" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="🔄 Actualiser l'état" Style="{StaticResource ActionButton}" Padding="10,4" FontSize="11" Click="BtnRefreshDefender_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Protection en temps réel :" Foreground="#9CA3AF"/>
                            <Border Grid.Column="1" x:Name="BadgeRealtime" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Background="#374151">
                                <TextBlock x:Name="TxtRealtimeStatus" Text="Vérification..." FontWeight="Bold" Foreground="#F9FAFB" FontSize="11"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Signatures antivirus :" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSignaturesDate" Text="—" Foreground="#F9FAFB" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Version du moteur AM :" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" x:Name="TxtEngineVersion" Text="—" Foreground="#D1D5DB"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Statut de l'analyse :" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" x:Name="TxtScanStatus" Text="—" Foreground="#D1D5DB"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions antivirales -->
                <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ACTIONS DE PROTECTION &amp; ANALYSE ANTIVIRUS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                        <!-- Action 1 : Scan rapide -->
                        <Border Background="#111827" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Analyse rapide Windows Defender" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Analyse rapide des zones mémoires et exécutables sensibles du système" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Lancer l'analyse" Style="{StaticResource PrimaryActionButton}" Padding="12,6" Click="BtnQuickScan_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 2 : Mettre à jour signatures -->
                        <Border Background="#111827" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Mettre à jour les signatures de sécurité" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Télécharge et applique immédiatement la dernière base virale Microsoft Defender" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Mettre à jour" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnUpdateSigs_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 3 : Menaces & Eicar -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📋 Menaces détectées (Historique)" Margin="0,0,4,0"
                                    Style="{StaticResource ActionButton}" Click="BtnThreats_Click"/>
                            <Button Grid.Column="1" Content="🧪 Test antivirus EICAR" Margin="4,0,0,0"
                                    Style="{StaticResource ActionButton}" Click="BtnEicar_Click"/>
                        </Grid>

                        <Button Content="⚙️ Ouvrir le Centre de Sécurité Windows officiel" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Padding="10,6" FontSize="11" Click="BtnOpenWindowsSecurity_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ONGLET 2 : ERREURS & PLANTAGES (BSOD) -->
            <Grid x:Name="PanelEvents" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filtre et raccourcis -->
                <Border Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔄 Analyser les erreurs" Style="{StaticResource PrimaryActionButton}" Click="BtnRefreshEvents_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtEventsCount" Text="Erreurs des dernières 24 heures" Foreground="#D1D5DB"
                                   VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="📉 Moniteur Fiabilité (Perfmon)" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnPerfmon_Click"/>
                        <Button Grid.Column="3" Content="📋 Observateur (Eventvwr)" Style="{StaticResource ActionButton}" Click="BtnEventvwr_Click"/>
                    </Grid>
                </Border>

                <!-- Liste visuelle des erreurs -->
                <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsEventsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="2,2,2,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Provider}" FontWeight="Bold" Foreground="#F87171" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2" Text="* Seules les erreurs critiques et avertissements majeurs sont répertoriés." Foreground="#6B7280" FontSize="11"/>
            </Grid>

            <!-- ONGLET 3 : TOP PROCESSUS & CHARGE RAM -->
            <Grid x:Name="PanelRam" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Résumé global de charge -->
                <Border Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CHARGE GLOBALE DE LA MÉMOIRE VIVE (RAM)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtRamTotalUsage" Text="Lecture de la charge mémoire..." FontSize="14" FontWeight="Bold" Foreground="#60A5FA"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Actualiser" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Click="BtnRefreshRam_Click"/>
                        <Button Grid.Column="2" Content="🖥️ Gestionnaire des tâches" Style="{StaticResource ActionButton}" Click="BtnTaskMgr_Click"/>
                    </Grid>
                </Border>

                <!-- Tableau du top processus -->
                <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- En-têtes -->
                        <Border Grid.Row="0" Background="#111827" CornerRadius="4" Padding="12,6" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="APPLICATION / PROCESSUS" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="PID" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="MÉMOIRE RAM" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsRamList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="2,2,2,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Pid}" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding MemoryMbText}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
