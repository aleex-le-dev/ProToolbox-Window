<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.AppsShellRepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réparation Store UWP &amp; Interface"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏬" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Réparation Store UWP &amp; Interface" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Débloquez le Microsoft Store, réenregistrez les paquets applicatifs et réparez le cache d'icônes."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Options de réparation -->
        <StackPanel Grid.Row="1">
            <!-- 1. Réparation Store & UWP -->
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Réinitialiser Microsoft Store &amp; UWP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Réinitialise le cache du Store (wsreset.exe) et réenregistre tous les packages applicatifs Windows universels."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairStore" Content="Réparer le Store" Style="{StaticResource ActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRepairStore_Click"/>
                </Grid>
            </Border>

            <!-- 2. Reconstruction cache icônes & miniatures -->
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🖼️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reconstruire le cache d'icônes et miniatures" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Supprime les bases iconcache*.db et thumbcache*.db corrompues puis relance immédiatement Explorer."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairIcons" Content="Réparer les icônes" Style="{StaticResource ActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRepairIcons_Click"/>
                </Grid>
            </Border>

            <!-- 3. Tout réparer en 1 clic -->
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cure complète Store &amp; Interface (1-clic)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Exécute séquentiellement la réinitialisation du Store, des paquets applicatifs et la reconstruction des icônes."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairAll" Content="🚀 Tout réparer" Style="{StaticResource PrimaryActionButton}"
                            Padding="16,10" VerticalAlignment="Center" Click="BtnRepairAll_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Statut & Fermer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgBar" Grid.Row="0" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="{DynamicResource BgCard}" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtStatus" Text="Sélectionnez l'action de réparation souhaitée." Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
