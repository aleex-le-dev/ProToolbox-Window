<Window x:Class="ScriptsWindows.Views.Controls.AppsShellRepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réparation Store UWP &amp; Interface"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏬" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Réparation Store UWP &amp; Interface" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Débloquez le Microsoft Store, réenregistrez les paquets applicatifs et réparez le cache d'icônes."
                       Foreground="#9CA3AF" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Options de réparation -->
        <StackPanel Grid.Row="1">
            <!-- 1. Réparation Store & UWP -->
            <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Réinitialiser Microsoft Store &amp; UWP" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Réinitialise le cache du Store (wsreset.exe) et réenregistre tous les packages applicatifs Windows universels."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairStore" Content="Réparer le Store" Style="{StaticResource ActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRepairStore_Click"/>
                </Grid>
            </Border>

            <!-- 2. Reconstruction cache icônes & miniatures -->
            <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🖼️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reconstruire le cache d'icônes et miniatures" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Supprime les bases iconcache*.db et thumbcache*.db corrompues puis relance immédiatement Explorer."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairIcons" Content="Réparer les icônes" Style="{StaticResource ActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRepairIcons_Click"/>
                </Grid>
            </Border>

            <!-- 3. Tout réparer en 1 clic -->
            <Border Background="#1F2937" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cure complète Store &amp; Interface (1-clic)" FontWeight="Bold" FontSize="14" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Exécute séquentiellement la réinitialisation du Store, des paquets applicatifs et la reconstruction des icônes."
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRepairAll" Content="🚀 Tout réparer" Style="{StaticResource PrimaryActionButton}"
                            Padding="16,10" VerticalAlignment="Center" Click="BtnRepairAll_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Statut & Fermer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgBar" Grid.Row="0" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="#1F2937" Foreground="#6366F1" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtStatus" Text="Sélectionnez l'action de réparation souhaitée." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
