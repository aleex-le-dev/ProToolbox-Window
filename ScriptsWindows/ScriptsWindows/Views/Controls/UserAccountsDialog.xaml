<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.UserAccountsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comptes utilisateurs"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="760" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Style="{StaticResource ActionButton}" VerticalAlignment="Center" Click="BtnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE716;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Comptes utilisateurs" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Comptes locaux de ce PC : droits, mots de passe, activation, création et suppression."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des comptes -->
            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
                <ListBox x:Name="ListAccounts" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListAccounts_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BgInput}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FontIcon}" FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        <Border Background="{DynamicResource AccentDim}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Session actuelle" FontSize="10.5" Foreground="{DynamicResource AccentText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Actions -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel x:Name="PanelActions" IsEnabled="False">
                            <TextBlock x:Name="TxtSelected" Text="Sélectionnez un compte" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="TxtSelectedInfo" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,14"/>

                            <TextBlock Text="Nouveau mot de passe" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PwdNew" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Définir" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Click="BtnSetPassword_Click"/>
                                <Button Grid.Column="2" Content="Retirer" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch"
                                        ToolTip="Supprimer le mot de passe : connexion sans mot de passe" Click="BtnRemovePassword_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,14"/>

                            <Button x:Name="BtnToggleAdmin" Content="Accorder les droits administrateur" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnToggleAdmin_Click"/>
                            <Button x:Name="BtnToggleEnabled" Content="Désactiver le compte" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnToggleEnabled_Click"/>
                            <Button x:Name="BtnDelete" Content="Supprimer le compte" Style="{StaticResource DangerActionButton}"
                                    HorizontalAlignment="Stretch" Click="BtnDelete_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Création -->
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Créer un compte local" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom d'utilisateur" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewName" Margin="0,0,0,8"/>
                            <TextBlock Text="Mot de passe (facultatif)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PwdCreate" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkCreateAdmin" Content="Administrateur" Margin="0,0,0,10"/>
                            <Button Content="Créer le compte" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Click="BtnCreate_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ProgressBar x:Name="ProgBar" Grid.Row="2" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0"/>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Text="Chargement des comptes…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
