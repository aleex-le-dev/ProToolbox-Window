<Window x:Class="ScriptsWindows.Views.Controls.ContextMenuItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnalisation du Menu Contextuel (Clic Droit)"
        Width="720" Height="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style Bouton Standard -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Indigo (Menu Classique) -->
        <Style x:Key="IndigoActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Vert (Activer) -->
        <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Rouge (Désactiver / Supprimer) -->
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Background="#1E293B" CornerRadius="10" Padding="10" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🖱️" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Menu Contextuel (Clic Droit Windows)" FontSize="17" FontWeight="Bold" Foreground="#F9FAFB"/>
                <TextBlock Text="Personnalisez le style du menu clic droit et ajoutez des raccourcis terminaux utiles positionnés dans le dossier actif."
                           FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Cartes de personnalisation -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <!-- Carte 1 : Clic droit classique Windows 10 -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <!-- Action à droite -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="BtnToggleClassicMenu" Content="✓ Activer menu Win 10"
                                    Style="{StaticResource IndigoActionButton}" FontSize="12.5"
                                    Click="BtnToggleClassicMenu_Click"/>
                        </StackPanel>

                        <!-- Icône et Infos -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🪟" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Menu Clic Droit Classique (Windows 10)" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <Border x:Name="BadgeClassicStatus" Background="#111827" BorderBrush="#374151" BorderThickness="1"
                                            CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtClassicStatus" Text="Vérification..." FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Affiche directement le grand menu classique complet de Windows 10 sans « Afficher d'autres options »."
                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                <TextBlock Text="Redémarre l'Explorateur Windows automatiquement pour une prise en compte immédiate."
                                           FontSize="11" Foreground="#818CF8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- Carte 2 : Ouvrir CMD (Admin) -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <!-- Action à droite -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="BtnToggleCmdAdmin" Content="✓ Activer au clic droit"
                                    Style="{StaticResource SuccessActionButton}" FontSize="12.5"
                                    Click="BtnToggleCmdAdmin_Click"/>
                        </StackPanel>

                        <!-- Icône et Infos -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="CMD" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ouvrir CMD (Admin)" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <Border x:Name="BadgeCmdAdminStatus" Background="#111827" BorderBrush="#374151" BorderThickness="1"
                                            CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCmdAdminStatus" Text="Non actif" FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Ajoute « Ouvrir CMD (Admin) » au clic droit sur le Bureau et dans tous vos dossiers."
                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                <TextBlock Text="S'ouvre avec les privilèges Administrateur positionné directement dans le dossier actif."
                                           FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- Carte 3 : Ouvrir PowerShell (Admin) -->
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                    <DockPanel LastChildFill="True">
                        <!-- Action à droite -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="BtnTogglePowerShellAdmin" Content="✓ Activer au clic droit"
                                    Style="{StaticResource SuccessActionButton}" FontSize="12.5"
                                    Click="BtnTogglePowerShellAdmin_Click"/>
                        </StackPanel>

                        <!-- Icône et Infos -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PS" FontSize="9.5" FontWeight="Bold" Foreground="#BAE6FD" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ouvrir PowerShell (Admin)" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <Border x:Name="BadgePowerShellAdminStatus" Background="#111827" BorderBrush="#374151" BorderThickness="1"
                                            CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPowerShellAdminStatus" Text="Non actif" FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Ajoute « Ouvrir PowerShell (Admin) » au clic droit sur le Bureau et dans tous vos dossiers."
                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                <TextBlock Text="Lance la console PowerShell en Administrateur positionnée dans le dossier actif."
                                           FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Barre d'action inférieure -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <Button Content="🔄 Redémarrer l'Explorateur"
                        Style="{StaticResource ActionButton}" Padding="12,5" FontSize="11.5"
                        Click="BtnRestartExplorer_Click"/>
                <TextBlock Text="Rafraîchit l'Explorateur Windows sans fermer vos applications ouvertes."
                           FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="Fermer" DockPanel.Dock="Right"
                        Style="{StaticResource ActionButton}" Padding="18,6" FontSize="12"
                        Click="BtnClose_Click"/>
            </DockPanel>
        </Border>

        <!-- 4. Barre de statut -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="8,5">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ℹ️" FontSize="11.5" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="Prêt. Activez ou retirez les options de votre menu contextuel selon vos besoins."
                           FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
