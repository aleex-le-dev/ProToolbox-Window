<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.AppInstallerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation d'Applications — Alex Toolkit"
        Width="780" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Gestionnaire d'Installation d'Applications" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Cochez les logiciels souhaités pour une installation groupée en un clic ou installez-les individuellement."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de sélection et commande globale -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tout cocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                    <Button Content="Tout décocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnDeselectAll_Click"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0 sélectionné(s)" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnInstallSelected" Content="🚀 Installer la sélection"
                        Style="{StaticResource PrimaryActionButton}" Padding="16,6" Click="BtnInstallSelected_Click"/>
            </Grid>
        </Border>

        <!-- Liste des 6 applications -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsAppsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="3,3,3,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Checked="ItemCheck_Changed" Unchecked="ItemCheck_Changed" Cursor="Hand"/>

                                    <!-- Icône -->
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center"/>

                                    <!-- Nom et Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Statut -->
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                                    <!-- Bouton individuel -->
                                    <Button Grid.Column="4" Content="{Binding ActionButtonText}" Style="{StaticResource ActionButton}" Padding="12,5" FontSize="11"
                                            Click="BtnInstallSingle_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Barre de progression -->
        <ProgressBar Grid.Row="3" x:Name="ProgressBatch" Height="4" Margin="0,8,0,0" Visibility="Collapsed"
                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource AccentText}" BorderThickness="0"/>

        <!-- Pied de page -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
