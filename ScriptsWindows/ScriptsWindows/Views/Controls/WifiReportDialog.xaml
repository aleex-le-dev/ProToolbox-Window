<Window x:Class="ScriptsWindows.Views.Controls.WifiReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapport de Santé Wi-Fi"
        Width="880" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Rapport de Santé et Diagnostic Wi-Fi" FontSize="19" FontWeight="Bold" Foreground="#F9FAFB"/>
                    <TextBlock Text="Historique complet des 3 derniers jours : sessions de connexion, déconnexions et événements radio."
                               Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre d'outils et actions -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnOpenBrowser" Content="🌐 Ouvrir dans le Navigateur" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryActionButton}" Click="BtnOpenBrowser_Click"/>

                <Button Grid.Column="1" x:Name="BtnExport" Content="💾 Exporter une copie" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}" Click="BtnExport_Click"/>

                <Button Grid.Column="2" x:Name="BtnRegenerate" Content="🔄 Regénérer le rapport" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}" Click="BtnRegenerate_Click"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock x:Name="TxtReportDate" Text="Rapport prêt." Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="4" Content="📂 Dossier source"
                        Style="{StaticResource ActionButton}" Padding="10,6" FontSize="11" Click="BtnOpenFolder_Click"/>
            </Grid>
        </Border>

        <!-- Zone d'affichage principale -->
        <Border Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
            <Grid>
                <!-- Visualiseur HTML intégré -->
                <WebBrowser x:Name="ReportWebBrowser" Visibility="Collapsed"/>

                <!-- Panneau de chargement / progression -->
                <Grid x:Name="PanelLoading" Visibility="Visible" Background="#111827">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Génération du rapport Wi-Fi en cours..." FontSize="16" FontWeight="Bold" Foreground="#F9FAFB" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows analyse les événements WLAN, NCSI, NDIS et compile les graphiques..."
                                   Foreground="#9CA3AF" FontSize="12" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <ProgressBar Width="260" Height="6" IsIndeterminate="True"
                                     Foreground="#4F46E5" Background="#374151" BorderThickness="0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Panneau d'information alternatif si aperçu indisponible -->
                <Grid x:Name="PanelInfo" Visibility="Collapsed" Background="#111827" Margin="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="✅ Rapport Wi-Fi généré avec succès !" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Le rapport officiel interactif Windows (wlan-report-latest.html) est prêt. Cliquez ci-dessous pour l'afficher en plein écran dans votre navigateur Web par défaut."
                                   Foreground="#D1D5DB" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="🌐 Afficher le rapport graphique dans le navigateur" Style="{StaticResource PrimaryActionButton}"
                                Padding="18,10" HorizontalAlignment="Center" Click="BtnOpenBrowser_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
