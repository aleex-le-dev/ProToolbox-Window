<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.WifiReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapport de Santé Wi-Fi"
        Width="880" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Rapport de Santé et Diagnostic Wi-Fi" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Historique complet des 3 derniers jours : sessions de connexion, déconnexions et événements radio."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre d'outils et actions -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnOpenBrowser" Content="🌐 Ouvrir dans le Navigateur" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryActionButton}" Click="BtnOpenBrowser_Click"/>

                <Button Grid.Column="1" x:Name="BtnExport" Content="💾 Exporter une copie" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}" Click="BtnExport_Click"/>

                <Button Grid.Column="2" x:Name="BtnRegenerate" Content="🔄 Regénérer le rapport" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}" Click="BtnRegenerate_Click"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock x:Name="TxtReportDate" Text="Rapport prêt." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="4" Content="📂 Dossier source"
                        Style="{StaticResource ActionButton}" Padding="10,6" FontSize="11" Click="BtnOpenFolder_Click"/>
            </Grid>
        </Border>

        <!-- Zone d'affichage principale -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
            <Grid>
                <!-- Visualiseur HTML intégré -->
                <WebBrowser x:Name="ReportWebBrowser" Visibility="Collapsed"/>

                <!-- Panneau de chargement / progression -->
                <Grid x:Name="PanelLoading" Visibility="Visible" Background="{DynamicResource BgDeep}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Génération du rapport Wi-Fi en cours..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows analyse les événements WLAN, NCSI, NDIS et compile les graphiques..."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <ProgressBar Width="260" Height="6" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentText}" Background="{DynamicResource BgInput}" BorderThickness="0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Panneau d'information alternatif si aperçu indisponible -->
                <Grid x:Name="PanelInfo" Visibility="Collapsed" Background="{DynamicResource BgDeep}" Margin="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="✅ Rapport Wi-Fi généré avec succès !" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Le rapport officiel interactif Windows (wlan-report-latest.html) est prêt. Cliquez ci-dessous pour l'afficher en plein écran dans votre navigateur Web par défaut."
                                   Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="🌐 Afficher le rapport graphique dans le navigateur" Style="{StaticResource PrimaryActionButton}"
                                Padding="18,10" HorizontalAlignment="Center" Click="BtnOpenBrowser_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
