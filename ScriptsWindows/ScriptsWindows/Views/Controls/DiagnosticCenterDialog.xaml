<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.DiagnosticCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre de Diagnostic Matériel et Système"
        Width="840" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Centre de Diagnostic Matériel et Système" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Audit complet de la configuration : carte mère, CPU, RAM, disques S.M.A.R.T., batterie et réseau."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de navigation par onglets -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="4" Margin="0,0,0,16" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnTabSystem" Content="🖥️ Système &amp; BIOS"
                        Click="TabButton_Click" Tag="TabSystem" Margin="2" Padding="6,8"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="1" x:Name="BtnTabCpuRam" Content="🧠 CPU &amp; RAM"
                        Click="TabButton_Click" Tag="TabCpuRam" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="2" x:Name="BtnTabStorage" Content="💾 Stockage &amp; S.M.A.R.T."
                        Click="TabButton_Click" Tag="TabStorage" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="3" x:Name="BtnTabPowerNet" Content="🔋 Batterie &amp; Réseau"
                        Click="TabButton_Click" Tag="TabPowerNet" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="4" x:Name="BtnTabTools" Content="⚡ Outils &amp; Actions"
                        Click="TabButton_Click" Tag="TabTools" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Zone de contenu des onglets -->
        <Grid Grid.Row="2" Margin="0,0,0,14">

            <!-- ONGLET 1 : SYSTÈME, CARTE MÈRE & BIOS -->
            <Grid x:Name="PanelSystem" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Identité Ordinateur -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="IDENTITÉ DE LA MACHINE &amp; SYSTÈME D'EXPLOITATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nom de la machine :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtComputerName" Text="Chargement..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fabricant / Modèle :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtComputerModel" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Système Windows :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsCaption" Text="—" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version / Build :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsBuild" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Carte Mère & BIOS -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="CARTE MÈRE &amp; FIRMWARE BIOS / UEFI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Carte mère (Fabricant) :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMoboManufacturer" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Modèle / Référence :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMoboProduct" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version du BIOS/UEFI :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBiosVersion" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date de version BIOS :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBiosDate" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 2 : CPU & RAM -->
            <Grid x:Name="PanelCpuRam" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Processeur -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PROCESSEUR (CPU)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nom du processeur :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuName" Text="Chargement..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cœurs / Threads :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuCores" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fréquence maximale :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuSpeed" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Températures sondes :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuTemp" Text="—" Foreground="{DynamicResource WarningText}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mémoire RAM -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MÉMOIRE VIVE PHYSIQUE (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🧪 Diagnostic Windows (mdsched)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnMdsched_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Capacité installée :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtRamTotal" Text="Chargement..." FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                                </Grid>

                                <TextBlock Text="Détail par barrette / slot mémoire :" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ItemsRamSticks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SlotName}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CapacityText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" Foreground="{DynamicResource AccentText}" FontSize="11"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TypeText}" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Manufacturer}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 3 : DISQUES & STOCKAGE S.M.A.R.T. -->
            <Grid x:Name="PanelStorage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Disques physiques -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DISQUES PHYSIQUES &amp; ÉTAT DE SANTÉ S.M.A.R.T." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ItemsPhysicalDisks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                                        <TextBlock Text="{Binding BusType}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                                        <TextBlock Text="{Binding SmartDetails}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding MediaType}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="4" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HealthStatus}" Foreground="{Binding HealthColor}" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Volumes & Espace libre -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="VOLUMES LOGIQUES &amp; OCCUPATION DE L'ESPACE DISQUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ItemsVolumesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3,0,3">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SpaceUsageText}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Height="6" Value="{Binding UsedPercent}" Maximum="100"
                                                                 Background="{DynamicResource BgCard}" Foreground="{Binding UsageBarColor}" BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 4 : BATTERIE & RÉSEAU -->
            <Grid x:Name="PanelPowerNet" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Alimentation & Batterie -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ALIMENTATION ET SANTÉ DE LA BATTERIE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📄 Générer rapport officiel (HTML)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnBatteryReport_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Niveau de charge :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryLevel" Text="Vérification..." FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="État d'alimentation :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryStatus" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Autonomie estimée :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryRuntime" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tension mesurée :" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryVoltage" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cartes Réseau actives -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="INTERFACES RÉSEAU &amp; CONNECTIVITÉ IP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🌐 Test Ping (Google / DNS)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnPingTest_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ItemsNetworkList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding InterfaceAlias}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Foreground="{DynamicResource AccentText}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Gateway}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DnsServers}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 5 : OUTILS & ACTIONS SYSTÈME -->
            <Grid x:Name="PanelTools" Visibility="Collapsed">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OUTILS DE DIAGNOSTIC ET RAPPORTS APPROFONDIS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                        <!-- Action 1 : Gestionnaire de démarrage -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🚀 Gestionnaire des programmes au démarrage" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Activer ou désactiver les applications qui se lancent au boot de Windows" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ouvrir le gestionnaire" Style="{StaticResource PrimaryActionButton}" Padding="12,6" Click="BtnOpenStartup_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 2 : Intégrité SFC -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Analyse d'intégrité SFC (sfc /scannow)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Vérifier et réparer automatiquement les fichiers système Windows corrompus" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Lancer l'analyse SFC" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnRunSfc_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 3 : Utilitaires Windows intégrés -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📊 Infos (msinfo32)" Style="{StaticResource ActionButton}" Margin="0,0,3,0" Padding="6,6" FontSize="11" Click="BtnMsinfo_Click"/>
                            <Button Grid.Column="1" Content="🎮 Vidéo (dxdiag)" Style="{StaticResource ActionButton}" Margin="3,0,3,0" Padding="6,6" FontSize="11" Click="BtnDxdiag_Click"/>
                            <Button Grid.Column="2" Content="⚙️ Matériel (devmgmt)" Style="{StaticResource ActionButton}" Margin="3,0,3,0" Padding="6,6" FontSize="11" Click="BtnDevmgmt_Click"/>
                            <Button Grid.Column="3" Content="📈 Moniteur (resmon)" Style="{StaticResource ActionButton}" Margin="3,0,0,0" Padding="6,6" FontSize="11" Click="BtnResmon_Click"/>
                        </Grid>

                        <!-- Action 4 : Générer rapport texte complet -->
                        <Button Content="📋 Générer l'audit complet du système en console" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Padding="12,7" Click="BtnFullAudit_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Actualiser les données" Style="{StaticResource ActionButton}" Padding="10,5" FontSize="11" Margin="0,0,12,0" Click="BtnRefreshAll_Click"/>
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
