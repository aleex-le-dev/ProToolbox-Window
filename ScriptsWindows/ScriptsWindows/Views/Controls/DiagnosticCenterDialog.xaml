<Window x:Class="ScriptsWindows.Views.Controls.DiagnosticCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre de Diagnostic Matériel et Système"
        Width="840" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Centre de Diagnostic Matériel et Système" FontSize="19" FontWeight="Bold" Foreground="#F9FAFB"/>
                    <TextBlock Text="Audit complet de la configuration : carte mère, CPU, RAM, disques S.M.A.R.T., batterie et réseau."
                               Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de navigation par onglets -->
        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="4" Margin="0,0,0,16" BorderBrush="#374151" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnTabSystem" Content="🖥️ Système &amp; BIOS"
                        Click="TabButton_Click" Tag="TabSystem" Margin="2" Padding="6,8"
                        Background="#4F46E5" Foreground="#F9FAFB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="1" x:Name="BtnTabCpuRam" Content="🧠 CPU &amp; RAM"
                        Click="TabButton_Click" Tag="TabCpuRam" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="2" x:Name="BtnTabStorage" Content="💾 Stockage &amp; S.M.A.R.T."
                        Click="TabButton_Click" Tag="TabStorage" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="3" x:Name="BtnTabPowerNet" Content="🔋 Batterie &amp; Réseau"
                        Click="TabButton_Click" Tag="TabPowerNet" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                <Button Grid.Column="4" x:Name="BtnTabTools" Content="⚡ Outils &amp; Actions"
                        Click="TabButton_Click" Tag="TabTools" Margin="2" Padding="6,8"
                        Background="Transparent" Foreground="#9CA3AF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Zone de contenu des onglets -->
        <Grid Grid.Row="2" Margin="0,0,0,14">

            <!-- ONGLET 1 : SYSTÈME, CARTE MÈRE & BIOS -->
            <Grid x:Name="PanelSystem" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Identité Ordinateur -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="IDENTITÉ DE LA MACHINE &amp; SYSTÈME D'EXPLOITATION" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nom de la machine :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtComputerName" Text="Chargement..." FontWeight="Bold" Foreground="#F9FAFB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fabricant / Modèle :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtComputerModel" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Système Windows :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsCaption" Text="—" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version / Build :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsBuild" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Carte Mère & BIOS -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="CARTE MÈRE &amp; FIRMWARE BIOS / UEFI" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Carte mère (Fabricant) :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMoboManufacturer" Text="—" Foreground="#F9FAFB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Modèle / Référence :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMoboProduct" Text="—" Foreground="#D1D5DB" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version du BIOS/UEFI :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBiosVersion" Text="—" Foreground="#F9FAFB"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date de version BIOS :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBiosDate" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 2 : CPU & RAM -->
            <Grid x:Name="PanelCpuRam" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Processeur -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PROCESSEUR (CPU)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nom du processeur :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuName" Text="Chargement..." FontWeight="Bold" Foreground="#F9FAFB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cœurs / Threads :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuCores" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fréquence maximale :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuSpeed" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Températures sondes :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuTemp" Text="—" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mémoire RAM -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MÉMOIRE VIVE PHYSIQUE (RAM)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🧪 Diagnostic Windows (mdsched)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnMdsched_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Capacité installée :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtRamTotal" Text="Chargement..." FontWeight="Bold" Foreground="#60A5FA"/>
                                </Grid>

                                <TextBlock Text="Détail par barrette / slot mémoire :" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ItemsRamSticks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SlotName}" FontWeight="Bold" Foreground="#9CA3AF" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CapacityText}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="11"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" Foreground="#60A5FA" FontSize="11"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TypeText}" Foreground="#D1D5DB" FontSize="11"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Manufacturer}" Foreground="#9CA3AF" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 3 : DISQUES & STOCKAGE S.M.A.R.T. -->
            <Grid x:Name="PanelStorage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Disques physiques -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DISQUES PHYSIQUES &amp; ÉTAT DE SANTÉ S.M.A.R.T." FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ItemsPhysicalDisks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="12"/>
                                                        <TextBlock Text="{Binding BusType}" Foreground="#9CA3AF" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding MediaType}" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="4" Background="#1F2937" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HealthStatus}" Foreground="{Binding HealthColor}" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Volumes & Espace libre -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="VOLUMES LOGIQUES &amp; OCCUPATION DE L'ESPACE DISQUE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ItemsVolumesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3,0,3">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="13"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#9CA3AF" FontSize="12"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SpaceUsageText}" Foreground="#D1D5DB" FontSize="11" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Height="6" Value="{Binding UsedPercent}" Maximum="100"
                                                                 Background="#1F2937" Foreground="{Binding UsageBarColor}" BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 4 : BATTERIE & RÉSEAU -->
            <Grid x:Name="PanelPowerNet" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Alimentation & Batterie -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ALIMENTATION ET SANTÉ DE LA BATTERIE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📄 Générer rapport officiel (HTML)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnBatteryReport_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Niveau de charge :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryLevel" Text="Vérification..." FontWeight="Bold" Foreground="#34D399"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="État d'alimentation :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryStatus" Text="—" Foreground="#F9FAFB"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Autonomie estimée :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryRuntime" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tension mesurée :" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBatteryVoltage" Text="—" Foreground="#D1D5DB"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cartes Réseau actives -->
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="INTERFACES RÉSEAU &amp; CONNECTIVITÉ IP" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🌐 Test Ping (Google / DNS)" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnPingTest_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ItemsNetworkList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding InterfaceAlias}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Foreground="#60A5FA" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Gateway}" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DnsServers}" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ONGLET 5 : OUTILS & ACTIONS SYSTÈME -->
            <Grid x:Name="PanelTools" Visibility="Collapsed">
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OUTILS DE DIAGNOSTIC ET RAPPORTS APPROFONDIS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                        <!-- Action 1 : Gestionnaire de démarrage -->
                        <Border Background="#111827" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🚀 Gestionnaire des programmes au démarrage" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Activer ou désactiver les applications qui se lancent au boot de Windows" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ouvrir le gestionnaire" Style="{StaticResource PrimaryActionButton}" Padding="12,6" Click="BtnOpenStartup_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 2 : Intégrité SFC -->
                        <Border Background="#111827" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Analyse d'intégrité SFC (sfc /scannow)" FontWeight="Bold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Vérifier et réparer automatiquement les fichiers système Windows corrompus" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Lancer l'analyse SFC" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnRunSfc_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 3 : Utilitaires Windows intégrés -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📊 Informations (msinfo32)" Style="{StaticResource ActionButton}" Margin="0,0,4,0" Click="BtnMsinfo_Click"/>
                            <Button Grid.Column="1" Content="⚙️ Périphériques (devmgmt)" Style="{StaticResource ActionButton}" Margin="4,0,4,0" Click="BtnDevmgmt_Click"/>
                            <Button Grid.Column="2" Content="📈 Moniteur (resmon)" Style="{StaticResource ActionButton}" Margin="4,0,0,0" Click="BtnResmon_Click"/>
                        </Grid>

                        <!-- Action 4 : Générer rapport texte complet -->
                        <Button Content="📋 Générer l'audit complet du système en console" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Padding="12,7" Click="BtnFullAudit_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Actualiser les données" Style="{StaticResource ActionButton}" Padding="10,5" FontSize="11" Margin="0,0,12,0" Click="BtnRefreshAll_Click"/>
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
