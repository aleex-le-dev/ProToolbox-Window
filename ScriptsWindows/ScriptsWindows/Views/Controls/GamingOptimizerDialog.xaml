<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.GamingOptimizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimiseur de Latence &amp; Mode Gaming Ultime"
        Width="740" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>


    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Optimiseur Gaming &amp; Latence" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Réduisez le ping en jeu, libérez 100% de la puissance processeur et activez la planification GPU matérielle."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Statut des 4 optimisations -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="État des réglages de performances :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 Actualiser" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnRefresh_Click"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Mode Jeu officiel Windows (Game Mode)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtGameModeStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Priorité processeur multimédia (SystemResponsiveness 100%)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtCpuPriorityStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Réduction de latence TCP (Nagle Disabled / Ping réduit)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtNagleStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="• Planification GPU accélérée matériellement (HAGS)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtHagsStatus" Grid.Column="1" Text="..." FontWeight="Bold" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Options principales -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Option 1 : Activer le mode gaming -->
            <Border x:Name="CardEnableGaming" Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activer le Mode Gaming Ultime" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Passe le processeur à 100% de réactivité pour les jeux, active HAGS et élimine le délai d'accusé de réception des paquets réseau."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnEnableGaming" Content="Activer le Boost" Style="{StaticResource PrimaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnEnableGaming_Click"/>
                </Grid>
            </Border>

            <!-- Option 2 : Revenir en arrière -->
            <Border x:Name="CardRestoreDefaults" Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚖️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Revenir en arrière (Réglages par défaut)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Rétablit les valeurs standards d'usine de Windows pour la pile réseau et le planificateur multimédia."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnRestoreDefaults" Content="Revenir en arrière" Style="{StaticResource SecondaryActionButton}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnRestoreDefaults_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre inférieure -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Sélectionnez une option ci-dessus." Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
