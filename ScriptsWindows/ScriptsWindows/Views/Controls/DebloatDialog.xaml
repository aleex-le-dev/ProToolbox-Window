<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.DebloatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Applications préinstallées"
        Width="820" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="700" MinHeight="540"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Applications préinstallées" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Supprime les jeux, publicités et applications promotionnelles livrés avec Windows ou le fabricant. Les composants essentiels ne sont jamais proposés."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Recommandées" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                        ToolTip="Coche uniquement le bloatware connu" Click="BtnSelectRecommended_Click"/>
                <Button Content="Aucune" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,4" MinHeight="28" Click="BtnSelectNone_Click"/>
            </StackPanel>
            <CheckBox x:Name="ChkOnlyRecommended" Content="Afficher uniquement le bloatware connu" IsChecked="True" VerticalAlignment="Center"
                      Checked="ChkOnlyRecommended_Changed" Unchecked="ChkOnlyRecommended_Changed"/>
        </DockPanel>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,4">
            <Grid>
            <StackPanel x:Name="PanelEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="26" Foreground="{DynamicResource SuccessText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucun bloatware connu sur ce PC" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock Text="Décochez le filtre ci-dessus pour afficher toutes les applications supprimables." Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListApps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Version}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="ChkAllUsers" Grid.Row="0" Margin="0,0,0,10"
                      Content="Supprimer aussi pour les autres comptes et empêcher la réinstallation sur les nouveaux comptes"/>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnRemove" Content="Supprimer la sélection" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Click="BtnRemove_Click"/>
                    <Button Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
                </StackPanel>
                <ProgressBar x:Name="ProgBar" DockPanel.Dock="Right" Width="120" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0"/>
                <TextBlock x:Name="TxtStatus" Text="Chargement des applications…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
