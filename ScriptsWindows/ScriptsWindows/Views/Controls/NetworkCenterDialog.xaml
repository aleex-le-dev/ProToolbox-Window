<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.NetworkCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre de Contrôle Réseau"
        Width="750" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style des boutons génériques -->

        <!-- Style bouton principal bleu/indigo -->

        <!-- Style bouton d'action d'urgence / Reset -->
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Centre de Contrôle Réseau" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Diagnostic en temps réel, gestionnaire DNS, réparation de connectivité et analyse réseau."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de navigation par onglets -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="4" Margin="0,0,0,16" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnTabDiag" Content="🩺 Diagnostic &amp; Triage"
                        Click="TabButton_Click" Tag="TabDiag" Margin="2" Padding="8,8"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="1" x:Name="BtnTabDns" Content="🌐 Serveurs DNS"
                        Click="TabButton_Click" Tag="TabDns" Margin="2" Padding="8,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="2" x:Name="BtnTabReset" Content="⚡ Dépannage &amp; Reset"
                        Click="TabButton_Click" Tag="TabReset" Margin="2" Padding="8,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="3" x:Name="BtnTabTools" Content="🔍 Scanners &amp; Outils"
                        Click="TabButton_Click" Tag="TabTools" Margin="2" Padding="8,8"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Zone de contenu des onglets -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            
            <!-- ONGLET 1 : DIAGNOSTIC & TRIAGE -->
            <Grid x:Name="PanelDiag" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Carte d'identité de l'adaptateur -->
                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="INTERFACE RÉSEAU PRINCIPALE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Adaptateur actif :" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDiagAdapter" Text="Détection..." Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Adresse IPv4 :" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDiagIp" Text="—" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Passerelle (Box) :" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDiagGateway" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Serveurs DNS :" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDiagDns" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tests de connectivité en direct -->
                <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TESTS DE CONNECTIVITÉ EN TEMPS RÉEL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>

                        <!-- Test 1 : Passerelle -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏠" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Liaison locale vers la Passerelle / Box" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtTestGwSub" Text="Test du ping vers l'adresse du routeur" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="BadgeTestGw" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTestGwStatus" Text="En attente" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Test 2 : Résolution DNS -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Résolution de noms de domaine (DNS)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtTestDnsSub" Text="Traduction de cloudflare.com en adresse IP" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="BadgeTestDns" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTestDnsStatus" Text="En attente" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Test 3 : Accès Internet extérieur -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Connectivité Internet mondiale" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtTestInetSub" Text="Accès externe vérifié vers le Web (1.1.1.1 &amp; google.com)" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="BadgeTestInet" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTestInetStatus" Text="En attente" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions de diagnostic -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnRunDiag" Content="🔄 Relancer le diagnostic complet" Margin="0,0,6,0"
                            Style="{StaticResource PrimaryActionButton}" Click="BtnRunDiag_Click"/>
                    <Button Grid.Column="1" x:Name="BtnCopyDiag" Content="📋 Triage console détaillé" Margin="6,0,0,0"
                            Style="{StaticResource ActionButton}" Click="BtnConsoleTriage_Click"/>
                </Grid>
            </Grid>

            <!-- ONGLET 2 : GESTIONNAIRE DNS -->
            <Grid x:Name="PanelDns" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sélection adaptateur & État DNS actuel -->
                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Adaptateur réseau à configurer :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbDnsAdapters" Height="36" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                                      BorderBrush="{DynamicResource BorderStrong}" SelectionChanged="CmbDnsAdapters_SelectionChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Actualiser" Margin="10,22,0,0"
                                Style="{StaticResource ActionButton}" Click="BtnDnsRefresh_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="DNS ACTUEL CONFIGURÉ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDnsCurrentVal" Text="Lecture..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="IP SUR CET ADAPTATEUR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDnsCurrentIp" Text="Lecture..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Presets DNS à appliquer -->
                <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="CHOISIR UN PROFIL DNS SÉCURISÉ &amp; PERFORMANT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                        <!-- Cloudflare -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Cloudflare DNS (1.1.1.1 / 1.0.0.1)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Plus rapide du monde, respect strict de la confidentialité (IPv4 &amp; IPv6)." Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Appliquer" Style="{StaticResource PrimaryActionButton}"
                                        Padding="14,6" Click="BtnApplyCloudflare_Click"/>
                            </Grid>
                        </Border>

                        <!-- Google -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Google Public DNS (8.8.8.8 / 8.8.4.4)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Excellente redondance mondiale et résolution fiable (IPv4 &amp; IPv6)." Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Appliquer" Style="{StaticResource ActionButton}"
                                        Padding="14,6" Click="BtnApplyGoogle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Quad9 -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🔒 Quad9 DNS (9.9.9.9 / 149.112.112.112)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Protection proactive avec blocage temps réel des sites malveillants." Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Appliquer" Style="{StaticResource ActionButton}"
                                        Padding="14,6" Click="BtnApplyQuad9_Click"/>
                            </Grid>
                        </Border>

                        <!-- DHCP -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 Restaurer DNS Automatique (DHCP)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Rétablit les serveurs DNS assignés automatiquement par votre Box ou routeur." Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restaurer" Style="{StaticResource ActionButton}"
                                        Padding="14,6" Click="BtnRestoreDhcp_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ONGLET 3 : DÉPANNAGE & RESET -->
            <Grid x:Name="PanelReset" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Description explicative -->
                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RÉSOLUTION DES CONFLITS &amp; COUPURES RÉSEAU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Utilisez ces réparations en cas de « Pas d'accès Internet », de sites inaccessibles, de déconnexions aléatoires ou de conflit d'adresse IP."
                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Actions de réparation unitaires -->
                <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Action 1 : Redémarrer cartes -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 Redémarrer les adaptateurs réseau" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Désactive et réactive immédiatement les cartes actives (déblocage physique)" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Exécuter" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnRestartAdapters_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 2 : Vider DNS & ARP -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🧹 Vider le cache DNS &amp; la table ARP" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Purge ipconfig /flushdns et arp -d * pour corriger les routes et adresses corrompues" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Exécuter" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnFlushDnsArp_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 3 : Renouveler IP -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="📡 Renouveler le bail IP (DHCP)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Libération puis nouvelle demande d'adresse IP auprès de votre Box (release / renew)" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Exécuter" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnRenewDhcp_Click"/>
                            </Grid>
                        </Border>

                        <!-- Action 4 : Winsock & TCP/IP -->
                        <Border Background="{DynamicResource BgDeep}" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Réinitialiser Winsock et la pile TCP/IP" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Restaure netsh winsock reset et netsh int ip reset (un redémarrage PC est requis)" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Exécuter" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnResetWinsockTcp_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grand Reset Global -->
                <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🚀 Grand Reset Réseau Automatique (7 étapes)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerText}"/>
                            <TextBlock Text="Exécute l'ensemble du protocole curatif : DNS, ARP, Winsock, TCP/IP et renouvellement IP complet."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Tout Réinitialiser" Style="{StaticResource DangerActionButton}"
                                Padding="16,8" Click="BtnGrandReset_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ONGLET 4 : SCANNERS & OUTILS -->
            <Grid x:Name="PanelTools" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Outil 1 : Scan Wi-Fi -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📶" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner Wi-Fi" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Analyse les bornes et réseaux sans fil environnants (SSID, BSSID, puissance du signal et canaux)."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Lancer le scan Wi-Fi" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="BtnScanWifi_Click"/>
                    </Grid>
                </Border>

                <!-- Outil 2 : Rapport Wi-Fi officiel -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Rapport de santé Wi-Fi" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Génère le rapport officiel Windows complet (wlanreport) et l'ouvre dans le navigateur par défaut."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Générer le rapport HTML" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="BtnReportWifi_Click"/>
                    </Grid>
                </Border>

                <!-- Outil 3 : Scan réseau local LAN -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🖥️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner Réseau Local (LAN)" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Détecte les adresses IP et machines actives sur votre sous-réseau local (1-254) avec noms d'hôtes."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Scanner le LAN" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="BtnScanLan_Click"/>
                    </Grid>
                </Border>

                <!-- Outil 4 : Connexions TCP actives -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Connexions TCP Actives" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Affiche les connexions réseau établies en direct et identifie les logiciels Windows qui communiquent."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Analyser les flux TCP" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="BtnAnalyzeFlux_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
