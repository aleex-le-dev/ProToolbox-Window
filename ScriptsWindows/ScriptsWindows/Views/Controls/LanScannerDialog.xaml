<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.LanScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner Réseau Local (LAN)"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🖥️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Scanner du Réseau Local (LAN)" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Cartographie et découverte des adresses IP, machines et équipements connectés à votre Box."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Barre de contrôle du Scan -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStartScan" Content="🚀 Lancer le Scan LAN"
                            Style="{StaticResource PrimaryActionButton}" Click="BtnStartScan_Click"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TxtSubnetInfo" Text="Détection de la plage réseau..." Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgDeep}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHostCount" Text="0 appareil(s)" Foreground="{DynamicResource SuccessText}" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- Barre de progression -->
                <ProgressBar x:Name="ProgressScan" Height="4" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource SuccessText}"
                             BorderThickness="0" Value="0" Maximum="100"/>
            </StackPanel>
        </Border>

        <!-- Liste visuelle des appareils détectés -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsLanList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,3,4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icône équipement -->
                                    <TextBlock Grid.Column="0" Text="{Binding DeviceIcon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    <!-- Adresse IP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IpAddress}" FontWeight="Bold" Foreground="{DynamicResource AccentText}" FontSize="13"/>
                                        <TextBlock Text="{Binding DeviceType}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Nom d'hôte -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <TextBlock Text="{Binding HostName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                        <TextBlock Text="Réponse au ping [OK]" Foreground="{DynamicResource SuccessText}" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Bouton Copier -->
                                    <Button Grid.Column="3" Content="📋 Copier" Style="{StaticResource ActionButton}"
                                            Padding="8,4" FontSize="11" Click="BtnCopyIp_Click" Tag="{Binding IpAddress}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Pied de page -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text="Prêt pour le scan." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
