<Window x:Class="ScriptsWindows.Views.Controls.WingetUpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire de Paquets et Mises à Jour (Winget)"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestionnaire de Paquets Winget" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Analysez vos logiciels, choisissez précisément les mises à jour à appliquer ou mettez tout à niveau d'un seul clic."
                       Foreground="#9CA3AF" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Onglets principaux -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,14">
            <!-- Onglet 1 : Mises à jour disponibles -->
            <TabItem Header="Mises à niveau disponibles" Foreground="#F9FAFB" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'outils Mises à jour -->
                    <Border Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🔄 Analyser les mises à jour" Style="{StaticResource ActionButton}"
                                    Padding="10,6" Click="BtnCheckUpdates_Click"/>

                            <CheckBox Grid.Column="1" x:Name="ChkForceUpgrade" IsChecked="True"
                                      Content="⚡ Forcer si conflit de scope (--force)"
                                      Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="14,0,10,0"
                                      Cursor="Hand" ToolTip="Contourne automatiquement l'erreur 'ne s'applique pas à votre système' causée par une différence entre scope utilisateur et machine."/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Content="Tout cocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                                <Button Content="Tout décocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnDeselectAll_Click"/>
                            </StackPanel>

                            <Button Grid.Column="3" x:Name="BtnUpdateSelected" Content="🚀 Mettre à jour la sélection" Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryActionButton}" Click="BtnUpdateSelected_Click"/>

                            <Button Grid.Column="4" Content="⚡ Tout mettre à niveau (--all)"
                                    Style="{StaticResource ActionButton}" Click="BtnUpdateAll_Click"/>
                        </Grid>
                    </Border>

                    <!-- Liste des mises à jour avec CheckBox -->
                    <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <ListBox x:Name="LstUpdates" Background="#111827" BorderBrush="#374151"
                                     Foreground="#F9FAFB" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F9FAFB" FontSize="13"/>
                                                    <TextBlock Text="{Binding Id}" Foreground="#9CA3AF" FontSize="11"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,14,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding VersionDisplay}" Foreground="#9CA3AF" FontSize="11"/>
                                                    <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding AvailableDisplay}" FontWeight="Bold" Foreground="#064E3B" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="Mettre à jour" VerticalAlignment="Center"
                                                        Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11"
                                                        Tag="{Binding}" Click="BtnUpdateSingle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Message état vide -->
                            <TextBlock x:Name="TxtNoUpdates" Text="Cliquez sur 'Analyser les mises à jour' pour détecter les applications obsolètes."
                                       Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : Applications installées -->
            <TabItem Header="Toutes les applications installées" Foreground="#F9FAFB" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🔄 Charger la liste complète" Style="{StaticResource ActionButton}"
                                    Padding="10,6" Click="BtnLoadInstalledApps_Click"/>

                            <TextBox Grid.Column="1" x:Name="TxtSearchApp" Height="32" Margin="12,0,0,0" Background="#111827"
                                     Foreground="#F9FAFB" BorderBrush="#4B5563" Padding="8,4" VerticalContentAlignment="Center"
                                     TextChanged="TxtSearchApp_TextChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <ListBox x:Name="LstInstalledApps" Background="#111827" BorderBrush="#374151"
                                     Foreground="#F9FAFB" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F9FAFB"/>
                                                    <TextBlock Text="{Binding Id}" Foreground="#9CA3AF" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtNoInstalled" Text="Cliquez sur 'Charger la liste complète' pour afficher tous les logiciels installés."
                                       Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Pied de page -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
