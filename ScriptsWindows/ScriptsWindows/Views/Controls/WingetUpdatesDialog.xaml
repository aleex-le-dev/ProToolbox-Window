<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.WingetUpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logiciels : mises à jour et inventaire"
        Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Logiciels : mises à jour et inventaire" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Mettez à jour vos logiciels en un clic et consultez l'inventaire complet de ce qui est installé (taille, date, éditeur, désinstallation, export)."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Onglets principaux -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,14" SelectionChanged="Tabs_SelectionChanged">
            <!-- Onglet 1 : Mises à jour disponibles -->
            <TabItem Header="Mises à niveau disponibles" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'outils Mises à jour -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🔄 Analyser les mises à jour" Style="{StaticResource ActionButton}"
                                    Padding="10,6" Click="BtnCheckUpdates_Click"/>

                            <CheckBox Grid.Column="1" x:Name="ChkForceUpgrade" IsChecked="True"
                                      Content="⚡ Forcer si conflit de scope (--force)"
                                      Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="14,0,10,0"
                                      Cursor="Hand" ToolTip="Contourne automatiquement l'erreur 'ne s'applique pas à votre système' causée par une différence entre scope utilisateur et machine."/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Content="Tout cocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                                <Button Content="Tout décocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnDeselectAll_Click"/>
                            </StackPanel>

                            <Button Grid.Column="3" x:Name="BtnUpdateSelected" Content="🚀 Mettre à jour la sélection" Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryActionButton}" Click="BtnUpdateSelected_Click"/>

                            <Button Grid.Column="4" Content="⚡ Tout mettre à niveau (--all)"
                                    Style="{StaticResource ActionButton}" Click="BtnUpdateAll_Click"/>
                        </Grid>
                    </Border>

                    <!-- Liste des mises à jour avec CheckBox -->
                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <ListBox x:Name="LstUpdates" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}"
                                     Foreground="{DynamicResource TextPrimary}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,14,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding VersionDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                    <Border Background="{DynamicResource Success}" CornerRadius="4" Padding="6,2" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding AvailableDisplay}" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="Mettre à jour" VerticalAlignment="Center"
                                                        Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11"
                                                        Tag="{Binding}" Click="BtnUpdateSingle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Message état vide -->
                            <TextBlock x:Name="TxtNoUpdates" Text="Cliquez sur 'Analyser les mises à jour' pour détecter les applications obsolètes."
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : Inventaire des logiciels installés -->
            <TabItem x:Name="TabInstalled" Header="Logiciels installés" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'outils : recherche, filtre, tri, export -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="TxtSearchApp" FontWeight="Normal" TextChanged="TxtSearchApp_TextChanged" VerticalContentAlignment="Center" Padding="30,0,8,0"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource FontIcon}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox Grid.Column="1" x:Name="CmbAppFilter" Width="200" Margin="8,0,0,0" FontWeight="Normal" SelectionChanged="AppFilter_Changed">
                            <ComboBoxItem Content="Tous les logiciels" IsSelected="True"/>
                            <ComboBoxItem Content="Logiciels de bureau"/>
                            <ComboBoxItem Content="Applications du Microsoft Store"/>
                            <ComboBoxItem Content="Installés ces 30 derniers jours"/>
                            <ComboBoxItem Content="Volumineux (plus de 1 Go)"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="CmbAppSort" Width="170" Margin="8,0,0,0" FontWeight="Normal" SelectionChanged="AppFilter_Changed">
                            <ComboBoxItem Content="Trier par nom" IsSelected="True"/>
                            <ComboBoxItem Content="Trier par taille"/>
                            <ComboBoxItem Content="Trier par date"/>
                            <ComboBoxItem Content="Trier par éditeur"/>
                        </ComboBox>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Excel (CSV)" Style="{StaticResource ActionButton}" FontWeight="Normal" Margin="0,0,6,0"
                                    ToolTip="Exporte la liste affichée au format CSV (s'ouvre dans Excel)" Click="BtnExportCsv_Click"/>
                            <Button Content="Rapport" Style="{StaticResource ActionButton}" FontWeight="Normal"
                                    ToolTip="Rapport HTML imprimable de la liste affichée" Click="BtnExportHtml_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="TxtInventorySummary" Text="" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,8"/>

                    <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                        <Grid>
                            <ListBox x:Name="LstInstalledApps" Background="Transparent" BorderThickness="0" FontWeight="Normal"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#xE838;" Style="{StaticResource IconButton}" ToolTip="Ouvrir le dossier d'installation"
                                                        IsEnabled="{Binding HasLocation}" Tag="{Binding}" Click="BtnOpenAppFolder_Click"/>
                                                <Button Content="Désinstaller" Style="{StaticResource ActionButton}" FontSize="11.5" Padding="10,2" MinHeight="26" Margin="6,0,0,0"
                                                        IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="BtnUninstallApp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtNoInstalled" Text="Chargement de l'inventaire…" FontWeight="Normal"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>        </TabControl>

        <!-- Pied de page -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="TxtFeedback" Text="Prêt." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
