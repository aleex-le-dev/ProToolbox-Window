<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.ProfileMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegarde &amp; migration de profil"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="780" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE8F7;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sauvegarde &amp; migration de profil" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" x:Name="TxtTotal" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Éléments" FontWeight="SemiBold" FontSize="14"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Sauvegarder" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Copie les éléments cochés dans un dossier daté sur la destination choisie (disque externe, clé USB, NAS)."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Button x:Name="BtnBackup" Content="Choisir la destination et sauvegarder" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Click="BtnBackup_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Restaurer" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Sur le nouveau PC : remet les éléments cochés dans le profil actuel. Rien n'est supprimé et un fichier plus récent n'est jamais écrasé."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Button x:Name="BtnRestore" Content="Choisir une sauvegarde et restaurer" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="BtnRestore_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="La sauvegarde contient les clés Wi-Fi en clair : conservez-la sur un support que vous contrôlez."
                               Foreground="{DynamicResource WarningText}" FontSize="11.5" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <ProgressBar x:Name="ProgBar" DockPanel.Dock="Right" Width="140" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0"/>
            <TextBlock x:Name="TxtStatus" Text="Calcul des tailles…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
