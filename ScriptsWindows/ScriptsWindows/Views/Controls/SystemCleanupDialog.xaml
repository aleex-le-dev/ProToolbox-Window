<Window x:Class="ScriptsWindows.Views.Controls.SystemCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nettoyage Système et Disque"
        Width="700" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanItemCheckbox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧹" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Nettoyage Système et Disque" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Purger les résidus, optimiser l'espace disque et lancer l'assistant natif Windows."
                       Foreground="#9CA3AF" FontSize="12" Margin="36,4,0,0"/>
        </StackPanel>

        <!-- Actions rapides / Outils natifs -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActionButton}" Click="BtnLaunchCleanmgr_Click" ToolTip="Lance l'assistant officiel de nettoyage de disque Windows">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cleanmgr natif" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="BtnLaunchStorageSense_Click" ToolTip="Ouvre les paramètres de gestion du stockage Windows 10/11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Paramètres Stockage" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource ActionButton}" Click="BtnCleanAllUnified_Click" ToolTip="Purge automatique rapide en un clic de tous les éléments recommandés">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tout nettoyer (1-clic)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Sélection personnalisée -->
        <Border Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barre d'outils de la sélection -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Éléments à nettoyer :" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalSizeFound" Text="Calcul en cours..." Foreground="#10B981" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔄 Analyser tailles" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Margin="0,0,8,0" Click="BtnAnalyze_Click"/>
                        <Button Content="Tout cocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                        <Button Content="Tout décocher" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnDeselectAll_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Liste des modules de nettoyage -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <!-- 1. Temporaires -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkTemp" Grid.Column="0" IsChecked="True" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📁 Fichiers temporaires (Utilisateur et Système)" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Dossiers %TEMP% et C:\Windows\Temp créés par les logiciels." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTempSize" Grid.Column="2" Text="-- MB" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2. Windows Update -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkWu" Grid.Column="0" IsChecked="True" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📦 Cache des téléchargements Windows Update" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="C:\Windows\SoftwareDistribution\Download (paquets d'installation déjà appliqués)." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtWuSize" Grid.Column="2" Text="-- MB" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 3. Corbeille -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkRecycleBin" Grid.Column="0" IsChecked="True" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🗑️ Corbeille Windows" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Purge définitive des fichiers supprimés sur l'ensemble des disques." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRecycleBinSize" Grid.Column="2" Text="-- MB" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 4. Caches navigateurs & miniatures -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkBrowsers" Grid.Column="0" IsChecked="True" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐 Caches navigateurs et miniatures Windows" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Caches Chrome, Edge, Firefox, Brave et miniatures Explorer (thumbcache)." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtBrowsersSize" Grid.Column="2" Text="-- MB" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 5. DNS & Presse-papiers -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkDnsAndClip" Grid.Column="0" IsChecked="True" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔌 Cache de résolution DNS et Presse-papiers" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Purge la table de résolution DNS (ipconfig /flushdns) et vide le presse-papiers." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Cache mémoire" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 6. Magasin WinSxS -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkWinSxS" Grid.Column="0" IsChecked="False" Style="{StaticResource CleanItemCheckbox}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🛠️ Magasin de composants WinSxS (DISM)" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                                    <TextBlock Text="Suppression des anciennes versions de composants système (peut prendre 3 à 8 min)." Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Avancé" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bouton d'action de la sélection -->
                <Button Grid.Row="2" x:Name="BtnCleanSelected" Style="{StaticResource PrimaryActionButton}" Margin="0,12,0,0" Height="40" Click="BtnCleanSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nettoyer les éléments sélectionnés" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Barre de statut & Pied de page -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgBar" Grid.Row="0" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="#1F2937" Foreground="#10B981" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Prêt. Cliquez sur un mode ou personnalisez les éléments à nettoyer." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
