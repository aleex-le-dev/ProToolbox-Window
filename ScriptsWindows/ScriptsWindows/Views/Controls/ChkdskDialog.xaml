<Window x:Class="ScriptsWindows.Views.Controls.ChkdskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification et Réparation de Disque (CHKDSK)"
        Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Vérification et Réparation CHKDSK" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Analysez et réparez les erreurs du système de fichiers et les secteurs défectueux."
                       Foreground="#9CA3AF" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Sélection du lecteur -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sélectionnez le lecteur à analyser :" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbDrives" Height="36" Background="#111827" Foreground="#F9FAFB"
                          BorderBrush="#4B5563" SelectionChanged="CmbDrives_SelectionChanged"/>
                <TextBlock x:Name="TxtDriveDirtyStatus" Text="État : Vérification en cours..." Foreground="#9CA3AF" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Choix du mode d'analyse -->
        <Border Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MODE D'ANALYSE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                <RadioButton x:Name="RbReadOnly" IsChecked="True" Margin="0,0,0,12" GroupName="ChkdskMode">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="🔍 Analyse rapide (Lecture seule)" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                        <TextBlock Text="Vérifie la cohérence du système de fichiers immédiatement sans bloquer ni redémarrer." Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RbFix" Margin="0,0,0,12" GroupName="ChkdskMode">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="🔧 Réparation du système de fichiers (/f)" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                        <TextBlock Text="Corrige les erreurs de structures et de métadonnées au prochain redémarrage." Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RbFull" GroupName="ChkdskMode">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="🛡️ Réparation complète et récupération des secteurs (/f /r)" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                        <TextBlock Text="Analyse approfondie de la surface du disque, isole les secteurs défectueux (recommandé si disque lent)." Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFeedback" Text="" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11"/>

            <Button Grid.Column="1" x:Name="BtnCancelSchedule" Content="❌ Annuler planification" Margin="0,0,10,0"
                    Style="{StaticResource ActionButton}" Click="BtnCancelSchedule_Click"/>

            <Button Grid.Column="2" x:Name="BtnRunChkdsk" Content="🚀 Lancer / Planifier"
                    Style="{StaticResource PrimaryActionButton}" Click="BtnRunChkdsk_Click"/>
        </Grid>
    </Grid>
</Window>
