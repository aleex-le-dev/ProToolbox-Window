<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.BenchmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banc d'essai des performances"
        Width="1100" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="960" MinHeight="640"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Comparer avec" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbCompare" Width="300" Margin="0,0,10,0" DisplayMemberPath="DisplayName" SelectionChanged="CmbCompare_SelectionChanged"/>
                <Button x:Name="BtnRun" Style="{StaticResource PrimaryActionButton}" Click="BtnRun_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRunLabel" Text="Lancer l'évaluation" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Banc d'essai des performances" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Indice officiel Windows (WinSAT), mesures réelles et comparatifs." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Bandeau de progression / avertissement -->
        <Border Grid.Row="1" x:Name="PanelProgress" Visibility="Collapsed" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtElapsed" Text="0:00" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontFamily="{StaticResource FontMono}"/>
                    <TextBlock x:Name="TxtStep" Text="Préparation…" FontWeight="SemiBold" FontSize="13"/>
                </DockPanel>
                <ProgressBar x:Name="ProgRun" Height="6" Maximum="1" Margin="0,8,0,6"/>
                <TextBlock Text="Ne touchez pas au PC pendant l'évaluation (2 à 5 minutes) : l'écran peut clignoter, c'est normal." Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" x:Name="PanelBattery" Visibility="Collapsed" Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="Le PC fonctionne sur batterie : branchez le chargeur avant l'évaluation, sinon les notes seront sous-estimées (mode économie d'énergie)."
                       Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Note globale -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="NOTE GLOBALE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        <Grid Width="200" Height="170" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Canvas x:Name="GaugeCanvas" Width="200" Height="170"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock x:Name="TxtGlobalScore" Text="—" FontFamily="{StaticResource FontDisplay}" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="sur 9,9" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtVerdict" Text="" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtVerdictDetail" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Border Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtBottleneck" Text="" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="TxtAdvice" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtDate" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,12,0,0"/>
                        <StackPanel x:Name="PanelHardware" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Notes par composant + mesures -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ce PC" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0"/>
                                    <Border Width="3" Height="12" Background="{DynamicResource WarningText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Comparatif" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="Notes par composant" FontWeight="SemiBold" FontSize="14"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelScores"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Mesures réelles" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMetricsLegend" Text="" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="PanelMetrics"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Historique -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Historique des évaluations de ce PC" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtNoHistory" Text="Une seule évaluation pour l'instant : relancez-la après une intervention (SSD, RAM, nettoyage…) pour mesurer le gain." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <StackPanel x:Name="PanelHistory"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Text="Chargement…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
