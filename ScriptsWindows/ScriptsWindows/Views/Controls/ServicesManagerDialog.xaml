<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True" x:Class="ScriptsWindows.Views.Controls.ServicesManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire des Services Windows"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestionnaire des Services Windows" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Pilotez et débloquez facilement les services clés du système (Spouleur, Windows Update, SysMain...)."
                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Sélecteur de service -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Service système :" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbServices" Height="36" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderStrong}" SelectionChanged="CmbServices_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Actualiser" Margin="10,22,0,0"
                        Style="{StaticResource ActionButton}" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- État détaillé du service -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ÉTAT ACTUEL DU SERVICE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Statut d'exécution :" Foreground="{DynamicResource TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="BadgeStatus" CornerRadius="4" Padding="8,2" Background="{DynamicResource BgInput}">
                            <TextBlock x:Name="TxtServiceStatus" Text="Lecture..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nom technique :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtServiceName" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Type de démarrage :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtStartupType" Text="—" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description :" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" x:Name="TxtDescription" Text="—" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions rapides sur le service -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnStart" Content="▶️ Démarrer" Margin="0,0,4,0"
                    Style="{StaticResource PrimaryActionButton}" Click="BtnStart_Click"/>
            <Button Grid.Row="0" Grid.Column="1" x:Name="BtnStop" Content="⏹️ Arrêter" Margin="4,0,4,0"
                    Style="{StaticResource ActionButton}" Click="BtnStop_Click"/>
            <Button Grid.Row="0" Grid.Column="2" x:Name="BtnRestart" Content="🔄 Redémarrer" Margin="4,0,0,0"
                    Style="{StaticResource ActionButton}" Click="BtnRestart_Click"/>

            <Button Grid.Row="1" Grid.ColumnSpan="3" x:Name="BtnPurgeSpooler"
                    Content="🖨️ Vider et débloquer la file d'attente d'impression"
                    Margin="0,8,0,0" Height="36"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource Success}" BorderBrush="{DynamicResource Success}"
                    Visibility="Collapsed" Click="BtnPurgeSpooler_Click"/>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🖥️ Ouvrir services.msc" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnOpenServicesMsc_Click"/>
                <TextBlock x:Name="TxtFeedback" Text="" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
