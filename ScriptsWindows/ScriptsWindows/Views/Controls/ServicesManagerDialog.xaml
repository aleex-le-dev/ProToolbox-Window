<Window x:Class="ScriptsWindows.Views.Controls.ServicesManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire des Services Windows"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F9FAFB"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#374151"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Gestionnaire des Services Windows" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Pilotez et débloquez facilement les services clés du système (Spouleur, Windows Update, SysMain...)."
                       Foreground="#9CA3AF" FontSize="12" Margin="34,4,0,0"/>
        </StackPanel>

        <!-- Sélecteur de service -->
        <Border Grid.Row="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Service système :" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbServices" Height="36" Background="#111827" Foreground="#F9FAFB"
                              BorderBrush="#4B5563" SelectionChanged="CmbServices_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Actualiser" Margin="10,22,0,0"
                        Style="{StaticResource ActionButton}" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- État détaillé du service -->
        <Border Grid.Row="2" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ÉTAT ACTUEL DU SERVICE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Statut d'exécution :" Foreground="#9CA3AF"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="BadgeStatus" CornerRadius="4" Padding="8,2" Background="#374151">
                            <TextBlock x:Name="TxtServiceStatus" Text="Lecture..." FontWeight="Bold" Foreground="#F9FAFB"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nom technique :" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="1" x:Name="TxtServiceName" Text="—" Foreground="#F9FAFB" FontWeight="SemiBold"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Type de démarrage :" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="1" x:Name="TxtStartupType" Text="—" Foreground="#F9FAFB"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description :" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Column="1" x:Name="TxtDescription" Text="—" Foreground="#D1D5DB" TextWrapping="Wrap" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions rapides sur le service -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnStart" Content="▶️ Démarrer" Margin="0,0,4,0"
                    Style="{StaticResource PrimaryActionButton}" Click="BtnStart_Click"/>
            <Button Grid.Column="1" x:Name="BtnStop" Content="⏹️ Arrêter" Margin="4,0,4,0"
                    Style="{StaticResource ActionButton}" Click="BtnStop_Click"/>
            <Button Grid.Column="2" x:Name="BtnRestart" Content="🔄 Redémarrer" Margin="4,0,0,0"
                    Style="{StaticResource ActionButton}" Click="BtnRestart_Click"/>
        </Grid>

        <!-- Pied de page -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🖥️ Ouvrir services.msc" Style="{StaticResource ActionButton}" Padding="8,4" FontSize="11" Click="BtnOpenServicesMsc_Click"/>
                <TextBlock x:Name="TxtFeedback" Text="" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
            <Button Content="Fermer" HorizontalAlignment="Right" Width="90"
                    Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
