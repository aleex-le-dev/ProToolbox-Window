<Window x:Class="ScriptsWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Alex Toolkit — AleexLeDev v4.0"
        Height="780" Width="1320"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource WindowGradientBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Sidebar gauche -->
            <ColumnDefinition Width="240" />
            <!-- 2. Contenu central -->
            <ColumnDefinition Width="*" />
            <!-- 3. Terminal latéral à droite -->
            <ColumnDefinition x:Name="TerminalColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--             1. SIDEBAR GAUCHE              -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo / Header -->
                <Border DockPanel.Dock="Top"
                        Padding="16,18,16,16"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ ALEEXLEDEV"
                                       FontFamily="{StaticResource FontMain}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="Alex Toolkit"
                                       FontFamily="{StaticResource FontMain}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="v4.0 — Edition Windows"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Bouton Thème proche du titre -->
                        <Button x:Name="BtnTheme"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="BtnTheme_Click"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Width="36" Height="36"
                                Cursor="Hand"
                                ToolTip="Changer de thème">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="15" FontFamily="{StaticResource FontEmoji}" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtThemeName" Visibility="Collapsed" Text="Noir Pur OLED" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Barre de recherche moderne avec watermark -->
                <Border DockPanel.Dock="Top" Padding="12,10,12,10">
                    <Border Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Grid.Column="0"
                                       Padding="8,6,4,6"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontEmoji}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13" />
                            <Grid Grid.Column="1">
                                <!-- Watermark Text -->
                                <TextBlock Text="Rechercher un outil..."
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource Accent}"
                                         Padding="4,7,8,7"
                                         FontFamily="{StaticResource FontMain}"
                                         FontSize="12.5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="0" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- Navigation principale -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,8,0">

                        <!-- Favoris -->
                        <Button x:Name="NavFavoris"
                                Style="{StaticResource SidebarItem}"
                                Click="NavFavoris_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_FAVORIS"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Text="&#xE735;"
                                               Foreground="#FBBF24"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Favoris" VerticalAlignment="Center" FontWeight="Medium" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Séparateur & En-tête Catégories -->
                        <Border Height="1" Background="{DynamicResource Border}" Margin="4,8,4,8" />
                        <TextBlock Text="CATÉGORIES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="10,2,0,6" />

                        <!-- 11 Catégories Principales (Triées par ordre alphabétique) -->
                        <Button Tag="APPLICATIONS" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_APPLICATIONS"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📦" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Applications" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="DIAGNOSTIC" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_DIAGNOSTIC"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                 </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Diagnostic" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="DISQUE" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_DISQUE"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💽" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Disque" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="MATERIEL" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_MATERIEL"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Matériel" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="MISES_A_JOUR" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_MISES_A_JOUR"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Mises à jour" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="NETTOYAGE" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_NETTOYAGE"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧹" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Nettoyage" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="PERSONNALISATION" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_PERSONNALISATION"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎨" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Personnalisation" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="REPARATION" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_REPARATION"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔧" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Réparation" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="RESEAU" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_RESEAU"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Réseau" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="SECRETS" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_SECRETS"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔑" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Secrets &amp; clés" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="SECURITE" Style="{StaticResource SidebarItem}" Click="NavCategory_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Badge_SECURITE"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Sécurité" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--           2. CONTENU PRINCIPAL             -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Header de page -->
                <RowDefinition Height="Auto" />
                <!-- Zone de contenu des pages -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header de page -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderGradient}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14,24,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Mes Favoris"
                                   Style="{StaticResource TitleText}"
                                   FontSize="20" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Vos outils préférés accessibles rapidement"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
            </Border>

            <!-- Zone de contenu des pages (transparente pour laisser voir le fond immersif) -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent" />
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--       3. TERMINAL LATÉRAL À DROITE         -->
        <!-- ══════════════════════════════════════════ -->
        <Grid x:Name="OutputPanel"
              Grid.Column="2"
              Width="520"
              MinWidth="350"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- Poignée de redimensionnement (curseur SizeWE) -->
                <ColumnDefinition Width="6" />
                <!-- Contenu de la console -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Poignée Splitter pour élargir ou réduire la console -->
            <Border Grid.Column="0"
                    x:Name="TerminalResizeGrip"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1,0,0,0"
                    Cursor="SizeWE"
                    ToolTip="Glisser vers la gauche pour élargir la console"
                    MouseLeftButtonDown="TerminalResizeGrip_MouseLeftButtonDown"
                    MouseMove="TerminalResizeGrip_MouseMove"
                    MouseLeftButtonUp="TerminalResizeGrip_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentDim}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Contenu du terminal -->
            <Border Grid.Column="1"
                    Background="{DynamicResource TerminalBg}">
                <DockPanel>
                    <!-- Toolbar du terminal -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgSidebar}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10,12,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text=">_ Console"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}" />
                            </StackPanel>
                            
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnZoomOut"
                                        Content="A-"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Padding="5,2,5,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Margin="0,0,2,0"
                                        Cursor="Hand"
                                        ToolTip="Réduire la taille du texte (Ctrl + Molette bas)"
                                        Click="BtnZoomOut_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnZoomIn"
                                        Content="A+"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Padding="5,2,5,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Margin="0,0,6,0"
                                        Cursor="Hand"
                                        ToolTip="Agrandir la taille du texte (Ctrl + Molette haut)"
                                        Click="BtnZoomIn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button x:Name="BtnCloseOutput"
                                        Content="✕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Padding="6,3,6,3"
                                        FontSize="11"
                                        Cursor="Hand"
                                        ToolTip="Fermer la console"
                                        Click="BtnCloseOutput_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Sortie texte en colonne droite (pleine hauteur) -->
                    <RichTextBox x:Name="OutputBox"
                                 Background="{DynamicResource TerminalBg}"
                                 BorderThickness="0"
                                 Padding="14,12,14,12"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="13.5"
                                 Foreground="{DynamicResource TerminalText}"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <FlowDocument PagePadding="0" FontSize="13.5" />
                    </RichTextBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
