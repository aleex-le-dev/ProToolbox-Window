<Window x:Class="ScriptsWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Boîte à Scripts Windows — AleexLeDev v4.0"
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Contenu principal -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--                  SIDEBAR                   -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo / Header -->
                <Border DockPanel.Dock="Top"
                        Padding="16,20,16,16"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="⚡ ALEEXLEDEV"
                                   FontFamily="{StaticResource FontMain}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"
 />
                        <TextBlock Text="Boîte à Scripts Windows"
                                   FontFamily="{StaticResource FontMain}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="v4.0 — WPF Edition"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Barre de recherche -->
                <Border DockPanel.Dock="Top" Padding="12,10,12,10">
                    <Border Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSM}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Grid.Column="0"
                                       Padding="8,6,4,6"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource Accent}"
                                     Padding="4,7,8,7"
                                     FontFamily="{StaticResource FontMain}"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- Navigation principale -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,8,0">

                        <!-- Favoris -->
                        <Button x:Name="NavFavoris"
                                Style="{StaticResource SidebarItem}"
                                Click="NavFavoris_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Mes Favoris" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Séparateur -->
                        <Separator Margin="0,8,0,8" Background="{StaticResource Border}" />

                        <!-- DIAGNOSTIC -->
                        <Button x:Name="NavDiagnostic" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="DIAGNOSTIC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Diagnostic" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- RÉPARATION -->
                        <Button x:Name="NavReparation" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="REPARATION">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Réparation" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- NETTOYAGE -->
                        <Button x:Name="NavNettoyage" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="NETTOYAGE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Nettoyage" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- RÉSEAU -->
                        <Button x:Name="NavReseau" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="RESEAU">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Réseau" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- DISQUE -->
                        <Button x:Name="NavDisque" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="DISQUE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💽" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Disque" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- APPLICATIONS -->
                        <Button x:Name="NavApplications" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="APPLICATIONS">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Applications" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- SÉCURITÉ -->
                        <Button x:Name="NavSecurite" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="SECURITE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔐" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Sécurité" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- EXTRACTION -->
                        <Button x:Name="NavExtraction" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="EXTRACTION">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Extraction" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- PERSONNALISATION -->
                        <Button x:Name="NavPersonnalisation" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="PERSONNALISATION">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Personnalisation" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- MATÉRIEL -->
                        <Button x:Name="NavMateriel" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" Tag="MATERIEL">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Matériel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer sidebar -->
                <Border DockPanel.Dock="Bottom"
                        Padding="16,12"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="🛡️ Mode Administrateur"
                               FontFamily="{StaticResource FontMain}"
                               FontSize="11"
                               Foreground="{StaticResource Success}" />
                </Border>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--                CONTENU PRINCIPAL           -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Header de page -->
                <RowDefinition Height="Auto" />
                <!-- Zone de contenu scrollable -->
                <RowDefinition Height="*" />
                <!-- Panel de sortie terminal (bas) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header de page -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16,24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PageTitle"
                                   Text="⭐ Mes Favoris"
                                   Style="{StaticResource TitleText}"
                                   FontSize="20" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Vos outils préférés accessibles rapidement"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- Indicateur d'exécution -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="RunningIndicator"
                                Background="#1A3A1A"
                                BorderBrush="{StaticResource Success}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusFull}"
                                Padding="10,4,10,4"
                                Visibility="Collapsed">
                            <TextBlock Text="⚙️ En cours..." FontSize="12" Foreground="{StaticResource Success}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Zone de contenu des pages -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BgDeep}" />

            <!-- Terminal Output Panel -->
            <Border x:Name="OutputPanel"
                    Grid.Row="2"
                    Background="#0A0A0A"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="220"
                    Visibility="Collapsed">
                <DockPanel>
                    <!-- Toolbar du terminal -->
                    <Border DockPanel.Dock="Top"
                            Background="#111"
                            Padding="12,6,12,6">
                        <DockPanel>
                            <TextBlock Text="⬛ Terminal"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnClearOutput"
                                        Content="Effacer"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="8,4,8,4"
                                        FontSize="11"
                                        Click="BtnClearOutput_Click" />
                                <Button x:Name="BtnCloseOutput"
                                        Content="✕"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="8,4,8,4"
                                        FontSize="11"
                                        Click="BtnCloseOutput_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Sortie texte -->
                    <ScrollViewer x:Name="OutputScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <RichTextBox x:Name="OutputBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12,8,12,8"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="12"
                                     Foreground="{StaticResource Success}"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="True" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
