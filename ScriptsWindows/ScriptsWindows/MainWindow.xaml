<Window x:Class="ScriptsWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Alex Toolkit"
        Height="800" Width="1320"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource FontMain}"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        Focusable="True"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- Compteur d'outils aligné à droite d'un élément de navigation -->
        <Style x:Key="NavCount" TargetType="TextBlock" BasedOn="{StaticResource SidebarBadgeText}" />
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="TerminalColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--             1. BARRE LATÉRALE              -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                x:Name="SidebarBorder"
                Width="240"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                MouseEnter="Sidebar_MouseEnter"
                MouseLeave="Sidebar_MouseLeave">
            <DockPanel>

                <!-- Identité de l'application -->
                <Border DockPanel.Dock="Top"
                        x:Name="SidebarHeaderBorder"
                        Padding="16,18,16,14">
                    <Grid>
                        <StackPanel x:Name="HeaderExpanded" Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                <TextBlock Text="A" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Alex Toolkit" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Maintenance Windows" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="HeaderCollapsed" Visibility="Collapsed"
                                Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Accent}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Alex Toolkit">
                            <TextBlock Text="A" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Recherche -->
                <Border DockPanel.Dock="Top" x:Name="SidebarSearchBorder" Padding="12,0,12,10">
                    <Border x:Name="SearchBoxBorder"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="34"
                            Cursor="IBeam"
                            ToolTip="Rechercher un outil (Échap pour effacer)"
                            MouseLeftButtonUp="SearchBorder_MouseLeftButtonUp">
                        <Grid>
                            <TextBlock x:Name="SearchIconCollapsed"
                                       Text="&#xE721;"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontIcon}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13" />

                            <Grid x:Name="SearchExpandedGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" Grid.Column="0"
                                           Margin="10,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontIcon}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" />
                                <Grid x:Name="SearchInputGrid" Grid.Column="1">
                                    <TextBlock Text="Rechercher un outil"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- TextBox minimal : aucun gabarit ModernWpf (pas de bordure ni de bouton « effacer » parasites) -->
                                    <TextBox x:Name="SearchBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource Accent}"
                                             SelectionBrush="{DynamicResource Accent}"
                                             FontSize="12.5"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"
                                             KeyDown="SearchBox_KeyDown">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0"
                                                              VerticalAlignment="Center" Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- Paramètres, ancré en bas -->
                <Border DockPanel.Dock="Bottom"
                        x:Name="SidebarSettingsBorder"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0"
                        Padding="8">
                    <Button x:Name="NavParametres"
                            ToolTip="Paramètres"
                            Style="{StaticResource SidebarItem}"
                            Click="NavParametres_Click"
                            MouseEnter="NavCategory_MouseEnter">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </Border>

                <!-- Navigation -->
                <ScrollViewer x:Name="SidebarScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryStackPanel" Margin="8,0,8,8">

                        <Button x:Name="NavFavoris" ToolTip="Favoris" Style="{StaticResource SidebarItem}"
                                Click="NavFavoris_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}">
                                    <TextBlock x:Name="Badge_FAVORIS" Text="0" Style="{StaticResource NavCount}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE734;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Favoris" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Border x:Name="CategoriesSeparator" Height="0" Margin="4,8,4,4" />
                        <TextBlock x:Name="CategoriesHeader"
                                   Text="OUTILS"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="10,4,0,6" />

                        <Button Tag="APPLICATIONS" ToolTip="Applications" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_APPLICATIONS" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Applications" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="DEMARRAGE" ToolTip="Démarrage &amp; récupération" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_DEMARRAGE" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Démarrage" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="DIAGNOSTIC" ToolTip="Diagnostic" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_DIAGNOSTIC" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Diagnostic" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="DISQUE" ToolTip="Disques et stockage" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_DISQUE" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Disques" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="MATERIEL" ToolTip="Performances &amp; énergie" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_MATERIEL" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Performances" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="MISES_A_JOUR" ToolTip="Mises à jour des programmes" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_MISES_A_JOUR" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Mises à jour" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="NETTOYAGE" ToolTip="Nettoyage &amp; espace disque" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_NETTOYAGE" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Nettoyage" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="NOUVEAUTE" ToolTip="Nouveautés" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_NOUVEAUTE" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEA80;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Nouveautés" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="PERSONNALISATION" ToolTip="Personnalisation de Windows" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_PERSONNALISATION" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Personnalisation" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="REPARATION" ToolTip="Dépannage &amp; réparation" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_REPARATION" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Réparation" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="RESEAU" ToolTip="Internet &amp; réseau" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_RESEAU" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Réseau" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="SECRETS" ToolTip="Mots de passe &amp; licences" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_SECRETS" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Mots de passe &amp; clés" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Tag="SECURITE" ToolTip="Sécurité &amp; antivirus" Style="{StaticResource SidebarItem}" Click="NavCategory_Click" MouseEnter="NavCategory_MouseEnter">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"><TextBlock x:Name="Badge_SECURITE" Text="0" Style="{StaticResource NavCount}" /></Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource SidebarIcon}" />
                                    <TextBlock Text="Sécurité" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--           2. CONTENU PRINCIPAL             -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="1" MouseEnter="MainContent_MouseEnter" PreviewMouseDown="MainContent_PreviewMouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête de page -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgDeep}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="28,20,28,18">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnUpdateNotification"
                            DockPanel.Dock="Right"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryActionButton}"
                            ToolTip="Une nouvelle version d'Alex Toolkit est disponible. Cliquez pour l'installer."
                            Click="BtnUpdateNotification_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtUpdateNotificationLabel" Text="Mise à jour disponible" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Favoris"
                                   Style="{StaticResource TitleText}"
                                   FontSize="22" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Vos outils préférés accessibles rapidement"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="12.5"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent" />
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--             3. CONSOLE DE SORTIE           -->
        <!-- ══════════════════════════════════════════ -->
        <Grid x:Name="OutputPanel"
              Grid.Column="2"
              Width="360"
              MinWidth="280"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Poignée de redimensionnement -->
            <Border Grid.Column="0"
                    x:Name="TerminalResizeGrip"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1,0,0,0"
                    Cursor="SizeWE"
                    ToolTip="Glisser pour redimensionner la console"
                    MouseLeftButtonDown="TerminalResizeGrip_MouseLeftButtonDown"
                    MouseMove="TerminalResizeGrip_MouseMove"
                    MouseLeftButtonUp="TerminalResizeGrip_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BgSidebar}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource TerminalBg}">
                <DockPanel>
                    <!-- Barre d'outils -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgSidebar}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1"
                            Padding="14,8,8,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnClearOutput" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                        ToolTip="Effacer la console" Click="BtnClearOutput_Click" />
                                <Button x:Name="BtnZoomOut" Content="&#xE71F;" Style="{StaticResource IconButton}"
                                        ToolTip="Réduire le texte (Ctrl + molette)" Click="BtnZoomOut_Click" />
                                <Button x:Name="BtnZoomIn" Content="&#xE8A3;" Style="{StaticResource IconButton}"
                                        ToolTip="Agrandir le texte (Ctrl + molette)" Click="BtnZoomIn_Click" />
                                <Button x:Name="BtnCloseOutput" Content="&#xE711;" Style="{StaticResource IconButton}"
                                        ToolTip="Fermer la console (interrompt le script en cours)" Click="BtnCloseOutput_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" FontFamily="{StaticResource FontIcon}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Console" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <RichTextBox x:Name="OutputBox"
                                 Background="{DynamicResource TerminalBg}"
                                 BorderThickness="0"
                                 Padding="14,12,14,12"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource TerminalText}"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <FlowDocument PagePadding="0" FontSize="12.5" LineHeight="18" />
                    </RichTextBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
