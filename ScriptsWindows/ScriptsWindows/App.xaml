<Application x:Class="ScriptsWindows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpfUI Fluent Design -->
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
                <!-- Thème personnalisé AleexLeDev -->
                <ResourceDictionary Source="Assets/Styles/Theme.xaml" />
                <ResourceDictionary Source="Assets/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
