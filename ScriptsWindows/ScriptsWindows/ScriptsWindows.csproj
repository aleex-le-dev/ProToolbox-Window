<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AlexToolkit</AssemblyName>
    <RootNamespace>ScriptsWindows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publication .exe unique autonome -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ── Optimisations de performance ────────────────────────── -->
    <!-- Tiered Compilation : JIT adaptatif (Quick JIT → Full JIT) -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <!-- ReadyToRun : pré-compilation AOT des méthodes fréquentes → démarrage plus rapide -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Pas de symboles de debug en release -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- ── Métadonnées & Icône ──────────────────────────────────── -->
    <Version>4.1.0</Version>
    <Company>AleexLeDev</Company>
    <Product>Alex Toolkit</Product>
    <Copyright>© 2026 AleexLeDev</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <!-- UI Fluent Design Windows 11 -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

</Project>
