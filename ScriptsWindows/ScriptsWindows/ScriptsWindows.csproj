<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AlexToolkit</AssemblyName>
    <RootNamespace>ScriptsWindows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publication .exe unique autonome -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Optimisations de rapidité (Tiered Compilation & QuickJIT) -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Métadonnées & Icône -->
    <Version>4.0.0</Version>
    <Company>AleexLeDev</Company>
    <Product>Alex Toolkit</Product>
    <Copyright>© 2026 AleexLeDev</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <!-- UI Fluent Design Windows 11 -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

</Project>
