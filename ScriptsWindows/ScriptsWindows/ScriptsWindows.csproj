<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AlexToolkit</AssemblyName>
    <RootNamespace>ScriptsWindows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publication .exe unique autonome -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- â”€â”€ Optimisations de performance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <!-- Tiered Compilation : JIT adaptatif (Quick JIT â†’ Full JIT) -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <!-- ReadyToRun : prÃ©-compilation AOT des mÃ©thodes frÃ©quentes â†’ dÃ©marrage plus rapide -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Pas de symboles de debug en release -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- â”€â”€ MÃ©tadonnÃ©es & IcÃ´ne â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <Version>4.2.6</Version>
    <Company>AleexLeDev</Company>
    <Product>Alex Toolkit</Product>
    <Copyright>Â© 2026 AleexLeDev</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <!-- UI Fluent Design Windows 11 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Date de gÃ©nÃ©ration / build automatique injectÃ©e Ã  la compilation -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Copie automatique du binaire autonome vers la racine du dÃ©pÃ´t lors de la publication -->
  <Target Name="CopyRootExeOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)AlexToolkit.exe" DestinationFolder="$(MSBuildThisFileDirectory)..\..\" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

</Project>
